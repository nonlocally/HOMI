<?xml version="1.0" encoding="utf-8"?>
<!--
  phonebridge — the one capability shell UID provably cannot have.

  Shell (uid 2000) can READ every notification through dumpsys, including the
  fact that 26 of them carry direct-reply actions right now. It cannot FIRE
  one: a PendingIntent is a live Binder token held in system_server, and
  dumpsys prints a description of it, not the thing itself. There is no path
  from that text back to a fireable object.

  Nor can Shizuku shortcut it. INotificationManager.registerListener() calls
  enforceSystemOrSystemUI(), which admits uid 1000 (system), 1001 (phone) and
  0 (root), and that check runs SERVER side, inside system_server. Shizuku's
  trick is bypassing the CLIENT side hidden-API blocklist, a different layer
  entirely. Verified against AOSP source, not guessed.

  So: an app, holding a bound NotificationListenerService, which is the only
  process that ever gets the live Notification.Action.

  Installed with `pm install` and granted with `cmd notification
  allow_listener`, which also happens to be the documented way past Android
  13's "Restricted settings" wall for sideloaded apps.

  It has a UI now — a native one, in Home. It still has no RESOURCES: every
  view is built in code and every icon and theme is a platform drawable, which
  is what keeps the build to four tool invocations and no Gradle.

  (XML comments cannot contain a double hyphen, which is why no flag is
  spelled out above. The first version of this file did spell one out and
  aapt2 rejected it as an invalid token.)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.aadarwal.phonebridge">

    <!-- Loopback only. The bridge is reached the same way `phone shelld` is:
         an ssh forward from the controller. Nothing listens off-device. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Apps targeting 30+ cannot see a service they have not declared an
         interest in. createOnDeviceSpeechRecognizer resolves through a
         resource overlay rather than a package query, but createSpeechRecognizer
         does query, so this is here to keep both paths open. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>

    <application android:label="homi"
                 android:icon="@android:drawable/ic_menu_compass"
                 android:allowBackup="false"
                 android:usesCleartextTraffic="false"
                 android:hasCode="true">

        <!-- The front door, and it is NATIVE. A launcher icon was not enough:
             the first version opened straight into a WebView on the board, so
             the app looked exactly like a browser bookmark and none of the
             things only an app can do (the listener, the on device recogniser,
             the warm speech engine) were visible anywhere. Home is the screen
             that shows them.

             Theme.Material.NoActionBar is a PLATFORM style, so we still ship
             no resources of our own. -->
        <activity
            android:name=".Home"
            android:exported="true"
            android:label="homi"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- One conversation, rendered by the fabric. Reached by tapping an
             agent on Home. NOT singleTask: each agent opens its own instance
             and Back returns to the list, which is what a person expects from
             a list of conversations. -->
        <activity
            android:name=".Homi"
            android:exported="false"
            android:label="homi"
            android:parentActivityName=".Home"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <!-- BIND_NOTIFICATION_LISTENER_SERVICE is a signature permission the
             SYSTEM holds, not us. Declaring it here is how we say "only the
             system may bind this service". -->
        <service
            android:name=".Listener"
            android:exported="true"
            android:label="phonebridge"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <!-- Invisible, and started from shell with `am start`. A mic
             foreground service cannot be STARTED from the background, and
             this app has no UI so it is permanently backgrounded. Being
             foreground for an instant is the exemption. -->
        <activity
            android:name=".Boot"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay"/>

        <!-- Measured, not assumed: with no foreground service, a listen
             returned an EMPTY callback trace after 12s. The recogniser never
             started. Android has blocked background mic since 9, and from 14
             a mic-touching service must declare the type explicitly. -->
        <service
            android:name=".VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone"/>

        <!-- The Talk button on the notification. A receiver, not an
             activity: tapping Talk must not bring anything to the screen,
             since the point is to speak without looking at the phone. -->
        <receiver
            android:name=".TalkReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.aadarwal.phonebridge.TALK"/>
            </intent-filter>
        </receiver>

        <!-- A Quick Settings tile, so Talk is one swipe away from the lock
             screen. The icon is a PLATFORM drawable — this app ships no
             resources of its own, which is what keeps the build to four
             tool invocations and no Gradle. -->
        <service
            android:name=".TalkTile"
            android:exported="true"
            android:icon="@android:drawable/ic_btn_speak_now"
            android:label="Talk"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>
    </application>
</manifest>
