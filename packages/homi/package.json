{
  "name": "@aadarwal/homi",
  "version": "0.1.0",
  "description": "homi \u2014 durable agent identity, mailboxes, and store-and-forward messaging for AI agents, as an MCP server. Two faces (CLI + MCP), one kernel.",
  "type": "module",
  "mcpName": "io.github.aadarwal/homi",
  "bin": {
    "homi": "dist/cli.js"
  },
  "files": [
    "dist",
    "vendor/*.py",
    "vendor/VERSION",
    "templates",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build": "node scripts/vendor.mjs && tsc",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "agents",
    "messaging",
    "mailbox",
    "identity",
    "claude",
    "codex"
  ],
  "license": "MIT"
}
