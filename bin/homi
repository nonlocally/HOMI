#!/usr/bin/env bash
# HOMI's public entry point. Keep each address space explicit and preserve the
# proven communicate implementation underneath it.
set -euo pipefail

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  self_dir="$(cd "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  [[ "$self" = /* ]] || self="$self_dir/$self"
done
root="$(cd "$(dirname "$self")/.." && pwd)"
cmd="${1:---help}"
[ "$#" -eq 0 ] || shift

package_cli() {
  local candidate
  for candidate in "${HOMI_PACKAGE_CLI:-}" \
      "$root/../src/homi.mjs" "$root/packages/communicate/src/homi.mjs"; do
    if [ -n "$candidate" ] && [ -f "$candidate" ]; then
      exec node "$candidate" "$cmd" "$@"
    fi
  done
  printf 'homi: package management is unavailable in this source-only payload; install a HOMI release.\n' >&2
  exit 127
}

case "$cmd" in
  help|-h|--help)
    cat <<'EOF'
HOMI — persistent agent identities, communication, and execution

  homi setup [--claude|--codex|--no-clients] [--service] [--dry-run]
  homi setup --guided              choose clients, dependencies and profiles
  homi setup --install-missing [--claude|--codex|--no-clients]
             [--terminal] [--mesh] [--ghostty] [--service|--no-service]
             [--yes] [--dry-run]
  homi doctor | version | update | rollback | uninstall

  homi start | status | agents
  homi claim NAME ...              assign a durable identity
  homi spawn ...                   create an agent execution
  homi send NAME MESSAGE ...       send durable mail
  homi inbox NAME                  read stored messages
  homi ask | reply | wait ...       request and receive replies
  homi seat ...                    observe and control execution

  homi bus ...                     register, discover, and message on a bus
  homi native ...                  existing communicate native/session commands
  homi profile ...                 optional terminal and mesh configuration

An identity can retain mail while its execution is stopped. Bus registration
and native sessions retain their own addresses and delivery capabilities.
The communicate command remains compatible. See docs/CLI.md for examples.
Bare setup in a terminal starts the guide. Dependencies are installed only
after a reviewed plan; noninteractive dependency setup requires --yes.
EOF
    ;;
  setup|update|rollback|uninstall|doctor|serve)
    package_cli "$@"
    ;;
  version|--version)
    if [ -f "$root/VERSION" ]; then
      printf 'HOMI '; cat "$root/VERSION"
    else
      package_cli "$@"
    fi
    ;;
  bus)
    exec "$root/bin/communicate" bus "$@"
    ;;
  native)
    exec "$root/bin/communicate" "$@"
    ;;
  profile|profiles)
    if [ ! -f "$root/profiles/manage.py" ]; then
      printf 'homi: profiles are unavailable in this installation.\n' >&2
      exit 127
    fi
    exec python3 "$root/profiles/manage.py" "$@"
    ;;
  daemon)
    exec "$root/bin/communicate" homi "$@"
    ;;
  *)
    exec "$root/bin/communicate" homi "$cmd" "$@"
    ;;
esac
