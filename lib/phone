_STATE_RE = re.compile(r"state=([A-Z_]+)\((\d+)\), position=(-?\d+)")


def parse_media_sessions(text):
    """`dumpsys media_session` -> structured sessions.

    This is the phone TELLING us what is playing. The alternative — the one
    the agent actually used to play a song tonight — was to dump the UI tree,
    read artist names off the screen and tap a coordinate. That is computer
    use, and it is the wrong tool when the device will simply answer the
    question: app, transport state, position, track, and the error if the
    session is broken.
    """
    out, cur = [], None
    # Which session will actually receive `cmd media_session dispatch`.
    # The command takes no session argument: it goes to the media button
    # session — the app that last held AUDIO — which is not necessarily the
    # foreground app, and not necessarily the one you just addressed with an
    # intent. Watched on the device: with YouTube Music foregrounded, active
    # and holding a loaded queue, `dispatch play` started Apple Music.
    bm = re.search(r"Media button session is ([A-Za-z0-9._]+)/", text or "")
    button = bm.group(1) if bm else None
    for raw in (text or "").splitlines():
        line = raw.strip()
        if line.startswith("package="):
            pkg = line.split("=", 1)[1].strip()
            cur = {"package": pkg, "active": False,
                   "state": None, "position_ms": None, "description": None,
                   "error": None,
                   "media_button": button is not None and pkg == button}
            out.append(cur)
            continue
        if cur is None:
            continue
        if line.startswith("active="):
            cur["active"] = line.split("=", 1)[1].strip() == "true"
        elif line.startswith("state=PlaybackState"):
            m = _STATE_RE.search(line)
            if m:
                cur["state"] = m.group(1)
                cur["position_ms"] = int(m.group(3))
            # error=... is last on the line and may contain commas/spaces.
            em = re.search(r"error=(.+?)\}\s*$", line)
            if em and em.group(1).strip() != "null":
                cur["error"] = em.group(1).strip()
        elif line.startswith("metadata:"):
            body = line.split(":", 1)[1].strip()
            dm = re.search(r"description=(.*)$", body)
            if dm and dm.group(1).strip() not in ("", "null"):
                cur["description"] = dm.group(1).strip()
    return out


def current_session(sessions):
    """The session that MATTERS.

    Not the first printed and not merely the first active one: an app can
    hold an active session that is erroring (Spotify sits there logged out,
    state=ERROR) and dispatching transport keys at it does nothing. Prefer
    something actually playing, then something paused with a real position,
    then anything active and not errored.
    """
    def rank(s):
        if s.get("error") or not s.get("active"):
            return -1
        if s.get("state") == "PLAYING":
            return 3
        if s.get("state") == "PAUSED":
            return 2
        return 1 if s.get("state") else 0
    best = max(sessions, key=rank) if sessions else None
    return best if best and rank(best) >= 0 else None


def describe_session(s):
    bits = [s["package"], (s.get("state") or "no state").lower()]
    if s.get("media_button"):
        bits.append("<- keys")
    if s.get("description"):
        bits.append(s["description"])
    if s.get("position_ms") not in (None, -1):
        bits.append("%d:%02d" % divmod(s["position_ms"] // 1000, 60))
    if s.get("error"):
        bits.append("error: %s" % s["error"])
    return "  ".join(bits)


def read_media(args):
    if getattr(args, "from_", None):
        with open(args.from_, "r", encoding="utf-8", errors="replace") as f:
            return parse_media_sessions(f.read())
    need_shell()
    _rc, out = dev_shell("dumpsys media_session", timeout=40)
    return parse_media_sessions(out or "")


# The transport keys `cmd media_session dispatch` accepts. NOT
# `input keyevent`: that injects a key into whatever happens to hold audio
# focus and exits 0 whether or not anything consumed it — the same
# report-success-you-did-not-observe shape as `input tap`. media_session
# targets the real session and, with dumpsys, lets us check afterwards.
DISPATCH = {"play": "play", "pause": "pause", "toggle": "play-pause",
            "next": "next", "prev": "previous", "stop": "stop"}


def cmd_media(args):
    sessions = read_media(args)
    if args.action in (None, "status"):
        if args.current:
            cur = current_session(sessions)
            if not cur:
                print("(nothing is playing)")
                return 0
            sessions = [cur]
        if args.json:
            print(json.dumps(sessions, indent=2))
            return 0
        if not sessions:
            print("(no media sessions)")
            return 0
        for s in sessions:
            print(describe_session(s))
        return 0

    need_shell()
    # Verify against the session the keys will actually reach. Comparing
    # `current_session` before and after re-ranks in between: if the dispatch
    # lands on a different app, the ranking can hand back a DIFFERENT session
    # afterwards, the two states differ, and the move reads as success —
    # crediting one app's playback to another.
    target = next((x for x in sessions if x.get("media_button")), None)
    before = target or current_session(sessions)
    if target and args.strict and current_session(sessions) is not None \
            and current_session(sessions).get("package") != target["package"]:
        die("the media keys go to %s, but the session that looks current is "
            "%s — name what you mean or drop --strict"
            % (target["package"], current_session(sessions)["package"]), 4)
    rc, _out = dev_shell("cmd media_session dispatch %s"
                         % DISPATCH[args.action], timeout=25)
    if rc != 0:
        record("media", {"action": args.action}, "act", "failed: dispatch", rc=1)
        die("could not dispatch %s to the media session" % args.action, 4)

    # Watch for the change rather than assuming it. A transport key can be
    # accepted and ignored — the app may not honour it, or the session may
    # have gone away between the read and the dispatch.
    def _same_session(fresh):
        """Re-find the SAME app, so before/after is one session's story."""
        if before is None:
            return current_session(fresh)
        for x in fresh:
            if x.get("package") == before["package"]:
                return x
        return None

    after = None
    for _ in range(6):
        time.sleep(0.5)
        after = _same_session(read_media(args))
        if _media_moved(before, after, args.action):
            break
    moved = _media_moved(before, after, args.action)
    record("media", {"action": args.action,
                     "package": (after or before or {}).get("package"),
                     "before": (before or {}).get("state"),
                     "after": (after or {}).get("state")}, "act",
           "%s -> %s" % (args.action, (after or {}).get("state") or "gone")
           if moved else
           "unconfirmed: dispatched %s, state did not change" % args.action)
    if after:
        print(describe_session(after))
    if not moved:
        sys.stderr.write("phone: dispatched %s but the session did not "
                         "change — it may have been ignored\n" % args.action)
        return 5
    return 0


def _media_moved(before, after, action):
    """Did the dispatch actually do anything we can see?"""
    if after is None:
        return False
    if action in ("play", "pause", "toggle", "stop"):
        return (before or {}).get("state") != after.get("state")
    # next/prev change the track, not the transport state.
    return (before or {}).get("description") != after.get("description")


def cmd_screen(args):
    need_shell()
    out_path = args.out or "screen.png"
    if display_id():
        # A virtual display cannot be screencap'd — see _vd_capture. The
        # holder that owns the Surface is the only process that can read it.
        data = _vd_capture(display_id())
        if not data:
            die("display %d produced no image" % display_id(), 4)
        if out_path == "-":
            record("screen", "stdout", "read")
            sys.stdout.buffer.write(data)
            sys.stdout.buffer.flush()
            return 0
        with open(out_path, "wb") as f:
            f.write(data)
        record("screen", out_path, "read")
        print(out_path)
        return 0
    # Same split, and the same unique-path rule: a screenshot that failed
    # must not hand back the last one that worked.
    remote = "/sdcard/.phone/shot-%d-%d.png" % (os.getpid(),
                                                int(time.time() * 1000))
    rc, _m = dev_shell("mkdir -p /sdcard/.phone && screencap -p %s" % remote,
                       timeout=60)
    data = dev_read(remote, want_bytes=True) if rc == 0 else b""
    dev_shell("rm -f %s" % remote, timeout=15)
    if not data and not os.environ.get("PHONE_NO_DEVICE") \
            and shutil.which("adb") and adb_ready():
        _rc, data = adb("exec-out", "screencap -p", timeout=60,
                        want_bytes=True)
    if not data:
        die("screenshot failed (screen off or secure surface)", 4)
    if out_path == "-":
        # Straight to stdout so the cockpit can stream it over ssh without
        # leaving a picture of someone's phone lying around on disk.
        record("screen", "stdout", "read")
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()
        return 0
    with open(out_path, "wb") as f:
        f.write(data)
    record("screen", out_path, "read")
    print(out_path)
    return 0


