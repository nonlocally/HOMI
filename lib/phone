    s.add_argument("--print-url", action="store_true", dest="print_url")

    s = add("log", cmd_log, "what the agent has done on this phone")
    s.add_argument("--limit", type=int, default=40)
    s.add_argument("--kind", choices=["act", "read"])
    s.add_argument("--actor", help="only what this driver did")
    s.add_argument("--json", action="store_true")

    s = add("media", cmd_media, "pause/play/next/prev/stop")
    s.add_argument("action", choices=["pause", "play", "next", "prev", "stop"])

    s = add("screen", cmd_screen, "screenshot to a png")
