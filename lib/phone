#!/usr/bin/env python3
"""phone — drive an Android device as a fabric surface.

The device analog of anu's `pane` and `nv`: one verb layer over the two
mechanisms an unrooted Android phone actually offers.

  termux-api   the device as a peripheral — speak, listen, notifications,
               camera, torch, location, clipboard, SMS.
  adb (self)   the device as a screen — see it (screencap), read it as text
               (uiautomator), touch it (input), launch it (am start).
               adb is connected from the phone TO ITSELF over wireless
               debugging, so no PC is tethered and nothing leaves the device.

Everything an agent needs is a verb here, so the brain never has to know
whether a capability comes from termux-api or adb. Any agent on the fabric —
local (ember) or remote (fable on the mini, crucible on the 88-core box) —
drives the phone by calling these verbs.

Stdlib only. Runs on the phone, in Termux.

The parsing verbs (`ui`, `find`, `notifs`) accept `--from FILE` so the logic
that an LLM depends on is testable off-device.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import xml.etree.ElementTree as ET

# Friendly names -> packages. An agent says "whatsapp", not a reverse-DNS id.
APPS = {
    "whatsapp": "com.whatsapp",
    "gmail": "com.google.android.gm",
    "mail": "com.google.android.gm",
    "signal": "org.thoughtcrime.securesms",
    "telegram": "org.telegram.messenger",
    "messages": "com.google.android.apps.messaging",
    "sms": "com.google.android.apps.messaging",
    "ytmusic": "com.google.android.apps.youtube.music",
    "youtubemusic": "com.google.android.apps.youtube.music",
    "youtube": "com.google.android.youtube",
    "spotify": "com.spotify.music",
    "maps": "com.google.android.apps.maps",
    "chrome": "com.android.chrome",
    "photos": "com.google.android.apps.photos",
    "calendar": "com.google.android.calendar",
    "slack": "com.Slack",
    "instagram": "com.instagram.android",
}


# Deep links: the LEVEL-1 path to app control. Android switches wireless
# debugging OFF on a network change or after idle, so anything that matters
# must not need adb. termux-open-url hands a link to Android, which routes it
# to the owning app — same result as `am start`, no adb involved.
LINKS = {
    "ytmusic": "https://music.youtube.com/search?q={q}",
    "youtubemusic": "https://music.youtube.com/search?q={q}",
    "spotify": "https://open.spotify.com/search/{q}",
    "youtube": "https://www.youtube.com/results?search_query={q}",
    "whatsapp": "https://wa.me/",
    "gmail": "https://mail.google.com/",
    "mail": "https://mail.google.com/",
    "maps": "https://maps.google.com/?q={q}",
    "photos": "https://photos.google.com/",
    "calendar": "https://calendar.google.com/",
    "chrome": "https://www.google.com/",
}


def is_url(s):
    return "://" in s or s.startswith("www.")


def pkg_of(name):
    if not name:
        return None
    n = name.strip().lower()
    if n in APPS:
        return APPS[n]
    return name if "." in name else None


def die(msg, code=2):
    sys.stderr.write("phone: %s\n" % msg)
    sys.exit(code)


def run(cmd, timeout=30, want_bytes=False):
    """Run a command. Returns (rc, out). Never raises on a non-zero exit."""
    try:
        r = subprocess.run(cmd, capture_output=True, timeout=timeout,
                           text=not want_bytes)
        return r.returncode, (r.stdout if r.stdout is not None else
                              (b"" if want_bytes else ""))
    except FileNotFoundError:
        return 127, (b"" if want_bytes else "")
    except subprocess.TimeoutExpired:
        return 124, (b"" if want_bytes else "")


def have_termux():
    if os.environ.get("PHONE_NO_DEVICE"):
        return False
    return shutil.which("termux-tts-speak") is not None


def need_termux():
    if not have_termux():
        die("no device: termux-api tools are not available here. "
            "`phone` runs ON the phone (Termux), not on the conductor.", 3)


def termux(name, *args, **kw):
    need_termux()
    exe = shutil.which(name)
    if not exe:
        die("no device: %s is missing (install the termux-api package AND "
            "the Termux:API app, signed by the same key as Termux)" % name, 3)
    return run([exe] + [str(a) for a in args], timeout=kw.get("timeout", 30))


def adb(*args, **kw):
    """adb against the phone's own wireless-debugging endpoint."""
    if os.environ.get("PHONE_NO_DEVICE"):
        die("no device: adb is unavailable", 3)
    exe = shutil.which("adb")
    if not exe:
        die("no device: adb is missing (pkg install android-tools)", 3)
    rc, out = run([exe] + [str(a) for a in args],
                  timeout=kw.get("timeout", 40),
                  want_bytes=kw.get("want_bytes", False))
    if rc == 127:
        die("no device: adb could not run", 3)
    return rc, out


def adb_ready():
    rc, out = adb("devices", timeout=15)
    return rc == 0 and re.search(r"\tdevice\s*$", out or "", re.M) is not None


def need_adb():
    if not adb_ready():
        die("adb is not connected — run `adb-heal` (the port rotates after a "
            "reboot; pairing itself persists)", 3)


# ---------------------------------------------------------------- UI parsing

class El(object):
    __slots__ = ("text", "desc", "rid", "cls", "clickable", "enabled",
                 "bounds", "parent")

    def __init__(self):
        self.text = ""
        self.desc = ""
        self.rid = ""
        self.cls = ""
        self.clickable = False
        self.enabled = True
        self.bounds = (0, 0, 0, 0)
        self.parent = None

    @property
    def center(self):
        x1, y1, x2, y2 = self.bounds
        return ((x1 + x2) // 2, (y1 + y2) // 2)

    @property
    def label(self):
        if self.text:
            return self.text
        if self.desc:
            return "[%s]" % self.desc
        return self.rid.split("/")[-1] if self.rid else ""


_BOUNDS = re.compile(r"\[(-?\d+),(-?\d+)\]\[(-?\d+),(-?\d+)\]")


def parse_ui(xml_text):
    """uiautomator XML -> flat element list, each knowing its parent.

    Parents matter: in real apps the visible label is a non-clickable TextView
    inside a clickable row, so tapping the label's own center can miss the
    handler entirely. `find` walks up from a match to the nearest clickable
    ancestor.
    """
    try:
        root = ET.fromstring(xml_text)
    except ET.ParseError as e:
        die("could not parse the UI tree (%s)" % e, 4)
    out = []

    def walk(node, parent):
        el = None
        if node.tag == "node":
            el = El()
            a = node.attrib
            el.text = (a.get("text") or "").strip()
            el.desc = (a.get("content-desc") or "").strip()
            el.rid = a.get("resource-id") or ""
            el.cls = a.get("class") or ""
            el.clickable = (a.get("clickable") == "true")
            el.enabled = (a.get("enabled") != "false")
            m = _BOUNDS.match(a.get("bounds") or "")
            if m:
                el.bounds = tuple(int(g) for g in m.groups())
            el.parent = parent
            out.append(el)
        for kid in list(node):
            walk(kid, el if el is not None else parent)

    walk(root, None)
    return out


def clickable_target(el):
    """The element that should actually receive the tap: el if it is
    clickable, else its nearest clickable-and-enabled ancestor."""
    cur = el
    while cur is not None:
        if cur.clickable and cur.enabled:
            return cur
        cur = cur.parent
    return None


def get_ui(from_file=None):
    if from_file:
        with open(from_file, "r", encoding="utf-8", errors="replace") as f:
            return f.read()
    need_adb()
    # uiautomator writes to a file on the device; /dev/tty streams it back.
    rc, out = adb("shell", "uiautomator dump /dev/tty", timeout=60)
    if "<hierarchy" not in (out or ""):
        rc, out = adb("shell",
                      "uiautomator dump /sdcard/ui.xml >/dev/null 2>&1; "
                      "cat /sdcard/ui.xml", timeout=60)
    if "<hierarchy" not in (out or ""):
        die("could not read the UI tree (the screen may be off or secure)", 4)
    i = out.index("<hierarchy")
    j = out.rfind("</hierarchy>")
    return out[i:j + len("</hierarchy>")] if j > 0 else out[i:]


def cmd_ui(args):
    els = parse_ui(get_ui(args.from_file))
    lines = []
    for el in els:
        lab = el.label
        if not lab:
            continue
        if args.grep and args.grep.lower() not in lab.lower():
            continue
        tgt = clickable_target(el)
        if tgt is None:
            lines.append("%-11s %s" % ("-", lab))
        else:
            x, y = tgt.center
            lines.append("%-11s %s" % ("%d,%d" % (x, y), lab))
    if not lines:
        print("(nothing readable on screen)")
        return 0
    print("\n".join(lines))
    return 0


def cmd_find(args):
    els = parse_ui(get_ui(args.from_file))
    if args.rid:
        # A resource-id is the stable handle: labels get translated and
        # reworded between app releases, ids rarely move.
        for el in els:
            if el.rid == args.rid:
                tgt = clickable_target(el)
                if tgt is not None:
                    x, y = tgt.center
                    print("%d %d" % (x, y))
                    return 0
        sys.stderr.write("phone: no enabled, tappable element with id %r\n"
                         % args.rid)
        return 1
    if not args.query:
        die("give a label to find, or --id <resource-id>", 2)
    q = args.query.lower()
    exact, partial = [], []
    for el in els:
        for hay in (el.text, el.desc):
            if not hay:
                continue
            h = hay.lower()
            if h == q:
                exact.append(el)
            elif q in h:
                partial.append(el)
            break
    for pool in (exact, partial):
        for el in pool:
            tgt = clickable_target(el)
            if tgt is not None:
                x, y = tgt.center
                print("%d %d" % (x, y))
                return 0
    # An honest miss. Never print coordinates we are not sure about: a wrong
    # tap on someone's phone is worse than no tap.
    sys.stderr.write("phone: no enabled, tappable element matching %r\n"
                     % args.query)
    return 1


# ------------------------------------------------------- notification inbox

def get_notifs(from_file=None):
    if from_file:
        with open(from_file, "r", encoding="utf-8", errors="replace") as f:
            raw = f.read()
    else:
        rc, raw = termux("termux-notification-list", timeout=40)
        if rc != 0 or not (raw or "").strip():
            die("could not read notifications — is Termux:API granted "
                "notification access? (cmd notification allow_listener "
                "com.termux.api/.apis.NotificationListAPI$NotificationService)",
                4)
    try:
        data = json.loads(raw)
    except ValueError:
        die("notification list was not JSON", 4)
    return data if isinstance(data, list) else []


def body_of(n):
    """The readable text of a notification.

    termux-notification-list has a long-standing bug where MessagingStyle
    notifications — group chats, i.e. exactly the messages that matter most —
    come back with content:"" while the actual text sits in `lines`. Taking
    `content` alone silently hides them, so fall through the alternatives.
    """
    for key in ("content", "bigText", "text"):
        v = n.get(key)
        if isinstance(v, str) and v.strip():
            return v.replace("\n", " ").strip()
    lines = n.get("lines")
    if isinstance(lines, list):
        joined = " / ".join(str(x).strip() for x in lines if str(x).strip())
        if joined:
            return joined
    return ""


def cmd_notifs(args):
    items = get_notifs(args.from_file)
    if args.app:
        want = pkg_of(args.app)
        if not want:
            die("unknown app %r (use a package name or one of: %s)"
                % (args.app, ", ".join(sorted(APPS))), 2)
        items = [n for n in items if n.get("packageName") == want]
    if args.since:
        items = [n for n in items if (n.get("when") or "") > args.since]
    record("notifs", {"app": args.app or "all", "n": len(items)}, "read")
    items.sort(key=lambda n: n.get("when") or "", reverse=True)
    if args.limit:
        items = items[:args.limit]
    if args.json:
        print(json.dumps(items, indent=2))
        return 0
    if not items:
        print("(no notifications)")
        return 0
    for n in items:
        app = (n.get("packageName") or "?").split(".")[-1]
        when = (n.get("when") or "")[11:16]
        title = n.get("title") or ""
        print("%s  %-10s %s: %s" % (when, app, title, body_of(n)))
    return 0


# ------------------------------------------------------------- device verbs

def cmd_say(args):
    text = " ".join(args.text)
    if not text.strip():
        die("nothing to say", 2)
    rc, _ = termux("termux-tts-speak", text, timeout=args.timeout)
    record("say", text[:200], "act")
    return 0 if rc == 0 else 1


def cmd_listen(args):
    need_termux()
    rc, out = termux("termux-speech-to-text", timeout=args.timeout)
    text = (out or "").strip()
    if not text:
        sys.stderr.write("phone: heard nothing\n")
        return 1
    print(text)
    return 0


def cmd_notify(args):
    rc, _ = termux("termux-notification", "--title", args.title,
                   "--content", args.content, "--id", str(args.id))
    return 0 if rc == 0 else 1


def cmd_tap(args):
    need_adb()
    adb("shell", "input tap %d %d" % (args.x, args.y))
    record("tap", "%d,%d" % (args.x, args.y), "act")
    return 0


def cmd_type(args):
    need_adb()
    text = " ".join(args.text)
    # `input text` is space-separated-token hostile; %s is the documented
    # escape, and quoting keeps the rest of the shell out of it.
    safe = text.replace("%", "%%").replace(" ", "%s")
    safe = re.sub(r"[^\w%@.,:;!?'\"/+()\[\]#&*-]", "", safe)
    adb("shell", "input text '%s'" % safe.replace("'", ""))
    record("type", text[:200], "act")
    return 0


def cmd_key(args):
    need_adb()
    k = args.key.upper()
    if not k.startswith("KEYCODE_"):
        k = "KEYCODE_" + k
    if not re.match(r"^KEYCODE_[A-Z0-9_]+$", k):
        die("bad keycode %r" % args.key, 2)
    adb("shell", "input keyevent %s" % k)
    return 0


def launch(url, print_only=False):
    """Level 1: hand a link to Android. No adb, so this keeps working when
    wireless debugging switches itself off."""
    if print_only:
        print(url)
        return 0
    exe = shutil.which("termux-open-url")
    if exe:
        rc, _ = run([exe, url], timeout=30)
        if rc == 0:
            return 0
    # Level 2 fallback, only if adb happens to be up.
    if not os.environ.get("PHONE_NO_DEVICE") and shutil.which("adb") \
            and adb_ready():
        adb("shell", "am start -a android.intent.action.VIEW -d %s"
            % json.dumps(url), timeout=30)
        return 0
    die("could not open %s (Termux:API missing and adb is down)" % url, 3)


def cmd_open(args):
    target = args.target
    if is_url(target):
        return launch(target, args.print_url)
    key = target.strip().lower()
    if key in LINKS:
        return launch(LINKS[key].replace("{q}", ""), args.print_url)
    p = pkg_of(target)
    if not p:
        die("unknown app %r (known: %s)" % (target, ", ".join(sorted(APPS))), 2)
    if args.print_url:
        die("%r has no deep link; it launches via adb only" % target, 2)
    need_adb()
    adb("shell", "monkey -p %s -c android.intent.category.LAUNCHER 1" % p,
        timeout=30)
    return 0


def cmd_play(args):
    from urllib.parse import quote_plus
    query = " ".join(args.query)
    app = (args.app or "ytmusic").strip().lower()
    tmpl = LINKS.get(app)
    if not tmpl or "{q}" not in tmpl:
        die("cannot search in %r — try ytmusic, spotify, or youtube" % app, 2)
    if not args.print_url:
        record("play", query, "act")
    return launch(tmpl.replace("{q}", quote_plus(query)), args.print_url)


SEND_IDS = ("com.whatsapp:id/send", "com.whatsapp:id/send_container")


def cmd_msg(args):
    """Open a chat with the message prefilled, and — with --send — press send.

    Two-way is the point: an assistant that can only draft is a notepad. What
    makes it safe is not a permission prompt on every message but the ledger:
    the send is recorded here, at the chokepoint, whether or not anyone is
    watching. --send additionally VERIFIES rather than assuming: it re-reads
    the screen and reports honestly if the message did not go.
    """
    from urllib.parse import quote
    app = args.app.strip().lower()
    if app != "whatsapp":
        die("msg currently supports whatsapp only", 2)
    num = re.sub(r"[^\d]", "", args.to or "")
    if not num:
        die("--to must be a phone number in international form", 2)
    url = "https://wa.me/%s" % num
    if args.text:
        url += "?text=%s" % quote(args.text, safe="")
    if args.print_url:
        return launch(url, True)
    if not args.send:
        rc = launch(url, False)          # dies loudly if it cannot open
        record("msg", {"app": app, "to": num, "text": args.text,
                       "sent": False}, "act", "drafted")
        return rc

    # --send needs to TOUCH the screen, which only the adb tier can do.
    if os.environ.get("PHONE_NO_DEVICE") or not shutil.which("adb") \
            or not adb_ready():
        record("msg", {"app": app, "to": num, "text": args.text,
                       "sent": False}, "act", "failed: no adb")
        die("cannot send: adb is down, so the send button cannot be pressed. "
            "Run `adb-heal`. (Refusing to report a send that did not happen.)",
            3)
    launch(url, False)
    import time as _t
    deadline = _t.time() + 25
    coords = None
    while _t.time() < deadline:
        _t.sleep(1.5)
        try:
            els = parse_ui(get_ui(None))
        except SystemExit:
            continue
        for el in els:
            if el.rid in SEND_IDS or (el.desc or "").strip().lower() == "send":
                tgt = clickable_target(el)
                if tgt is not None:
                    coords = tgt.center
                    break
        if coords:
            break
    if not coords:
        record("msg", {"app": app, "to": num, "text": args.text,
                       "sent": False}, "act", "failed: no send button")
        die("cannot send: never found the send button (the chat may not have "
            "opened). Nothing was sent.", 4)
    adb("shell", "input tap %d %d" % coords)
    _t.sleep(2.0)
    # Verify rather than assume: after a send the composer empties, so the
    # send affordance disappears. If it is still there, the tap did not take.
    still = False
    try:
        for el in parse_ui(get_ui(None)):
            if el.rid in SEND_IDS or (el.desc or "").strip().lower() == "send":
                still = True
                break
    except SystemExit:
        still = False
    if still:
        record("msg", {"app": app, "to": num, "text": args.text,
                       "sent": False}, "act", "unconfirmed")
        sys.stderr.write("phone: tapped send but the composer still looks "
                         "full — treat as UNSENT and check the thread\n")
        return 1
    record("msg", {"app": app, "to": num, "text": args.text, "sent": True},
           "act", "sent")
    print("sent to %s" % num)
    return 0


def cmd_media(args):
    need_adb()
    keys = {"pause": "KEYCODE_MEDIA_PAUSE", "play": "KEYCODE_MEDIA_PLAY",
            "next": "KEYCODE_MEDIA_NEXT", "prev": "KEYCODE_MEDIA_PREVIOUS",
            "stop": "KEYCODE_MEDIA_STOP"}
    adb("shell", "input keyevent %s" % keys[args.action])
    return 0


def cmd_screen(args):
    need_adb()
    out_path = args.out or "screen.png"
    rc, data = adb("exec-out", "screencap -p", timeout=60, want_bytes=True)
    if rc != 0 or not data:
        die("screenshot failed (screen off or secure surface)", 4)
    if out_path == "-":
        # Straight to stdout so the cockpit can stream it over ssh without
        # leaving a picture of someone's phone lying around on disk.
        record("screen", "stdout", "read")
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()
        return 0
    with open(out_path, "wb") as f:
        f.write(data)
    record("screen", out_path, "read")
    print(out_path)
    return 0


def cmd_photo(args):
    rc, _ = termux("termux-camera-photo", "-c", str(args.cam), args.out,
                   timeout=60)
    if rc != 0:
        return 1
    print(args.out)
    return 0


def cmd_torch(args):
    rc, _ = termux("termux-torch", args.state)
    record("torch", args.state, "act")
    return 0 if rc == 0 else 1


def cmd_battery(args):
    rc, out = termux("termux-battery-status")
    if rc != 0:
        return 1
    try:
        d = json.loads(out)
        print("%s%%  %s  %s" % (d.get("percentage"), d.get("status", "?"),
                                d.get("plugged", "")))
    except ValueError:
        print((out or "").strip())
    return 0


def cmd_where(args):
    rc, out = termux("termux-location", "-p",
                     args.provider, timeout=60)
    print((out or "").strip())
    return 0 if rc == 0 else 1


def cmd_clip(args):
    if args.action == "get":
        rc, out = termux("termux-clipboard-get")
        print((out or "").rstrip("\n"))
        return 0 if rc == 0 else 1
    rc, _ = termux("termux-clipboard-set", " ".join(args.text))
    return 0 if rc == 0 else 1


def cmd_apps(args):
    need_adb()
    rc, out = adb("shell", "pm list packages -3", timeout=40)
    pkgs = sorted(l.replace("package:", "").strip()
                  for l in (out or "").splitlines() if l.strip())
    rev = {v: k for k, v in APPS.items()}
    for p in pkgs:
        if args.grep and args.grep.lower() not in p.lower():
            continue
        print("%-45s %s" % (p, rev.get(p, "")))
    return 0


def cmd_foreground(args):
    need_adb()
    rc, out = adb("shell", "dumpsys activity activities", timeout=40)
    m = re.search(r"ResumedActivity.*?([a-zA-Z0-9_.]+/[a-zA-Z0-9_.$]+)",
                  out or "")
    print(m.group(1) if m else "(unknown)")
    return 0


def find_cli():
    """Locate the homi CLI without relying on PATH — see cmd_ptt: the shell a
    notification action runs in has a minimal PATH."""
    for c in ("communicate", "homi"):
        w = shutil.which(c)
        if w:
            return w
    home = os.path.expanduser("~")
    for cand in (os.path.join(home, ".local", "bin", "communicate"),
                 os.path.join(home, ".local", "bin", "homi")):
        if os.access(cand, os.X_OK):
            return cand
    return None



# ------------------------------------------------------------- action ledger
# Full two-way agency on someone's real phone is acceptable when it is
# ACCOUNTABLE, not when it is gated into uselessness. Every capability on this
# device flows through this CLI, which makes this CLI the one chokepoint where
# a record can be written — an agent cannot act on the phone without leaving a
# trace here. The cockpit renders this ledger; that is the safety property.
#
# What gets recorded:
#   act   — anything that changes the world (send, tap, type, play, torch...)
#   read  — reads of PERSONAL data (the inbox, the screen, location)
# Mechanical reads (ui, find, battery, apps) are deliberately NOT recorded:
# a record nobody can read is not accountability, it is noise.

def ledger_path():
    p = os.environ.get("PHONE_LEDGER")
    if p:
        return p
    return os.path.join(os.path.expanduser("~"), ".local", "state",
                        "communicate", "phone-actions.jsonl")


def record(verb, detail, kind="act", result=None):
    import time as _t
    row = {"ts": round(_t.time(), 3), "verb": verb, "kind": kind,
           "detail": detail}
    if result is not None:
        row["result"] = result
    path = ledger_path()
    try:
        d = os.path.dirname(path)
        if d and not os.path.isdir(d):
            os.makedirs(d, 0o700)
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(row) + "\n")
        try:
            os.chmod(path, 0o600)   # it holds message text and contacts
        except OSError:
            pass
    except OSError:
        # Never let bookkeeping break the action itself; but say so, so a
        # missing trail is visible rather than silent.
        sys.stderr.write("phone: WARNING could not write the action ledger\n")


def cmd_log(args):
    path = ledger_path()
    rows = []
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rows.append(json.loads(line))
                except ValueError:
                    continue
    except OSError:
        rows = []
    if args.kind:
        rows = [r for r in rows if r.get("kind") == args.kind]
    rows.reverse()
    if args.limit:
        rows = rows[:args.limit]
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    if not rows:
        print("(no actions recorded)")
        return 0
    import time as _t
    for r in rows:
        when = _t.strftime("%H:%M", _t.localtime(r.get("ts") or 0))
        mark = "*" if r.get("kind") == "act" else " "
        det = r.get("detail")
        if not isinstance(det, str):
            det = json.dumps(det)
        res = r.get("result")
        print("%s %s %-8s %s%s" % (when, mark, r.get("verb") or "?", det,
                                   ("  -> " + str(res)) if res else ""))
    return 0


VOICE_FRAME = (
    "[spoken aloud by @aadarwal into the phone. This is a VOICE turn: answer "
    "out loud by running `phone say \"<your answer>\"`, and keep it to one or "
    "two sentences — it is being listened to, not read. Use the `phone` verbs "
    "to act on the device.]\n\n%s"
)


def cmd_voice(args):
    if args.text is not None:
        text = args.text
    else:
        need_termux()
        rc, out = termux("termux-speech-to-text", timeout=args.timeout)
        text = (out or "").strip()
        if text and not args.quiet:
            # An early acknowledgement is the cheapest latency win there is:
            # the brain's answer is seconds away, but silence feels broken.
            run([shutil.which("termux-tts-speak") or "true", "ok"], timeout=10)
    if not (text or "").strip():
        if args.text is None and have_termux():
            termux("termux-tts-speak", "I didn't catch that", timeout=15)
        sys.stderr.write("phone: nothing heard\n")
        return 1
    prompt = VOICE_FRAME % text.strip()
    if args.seat:
        # The brain is on THIS device: type into its pane. Shorter and more
        # reliable than the mail plane, and it works with agent builds that
        # predate live-mail delivery.
        tmux = shutil.which("tmux") or "tmux"
        # An agent's composer treats an embedded newline as "keep typing", so
        # a multi-line prompt lands STAGED and unsubmitted. Send it as one
        # line, then Enter as a separate keystroke. (Observed live: the turn
        # sat in the composer until this was split.)
        flat = " ".join(prompt.split())
        argv = [tmux, "send-keys", "-t", args.seat, "-l", flat]
        if args.print_only:
            print(" ".join([tmux, "send-keys", "-t", args.seat, "-l",
                            "<prompt>"]))
            print(flat)
            return 0
        rc, out = run(argv, timeout=30)
        if rc != 0:
            die("could not reach seat %s: %s" % (args.seat, (out or "").strip()),
                4)
        import time as _t
        _t.sleep(0.4)
        run([tmux, "send-keys", "-t", args.seat, "Enter"], timeout=15)
        print("delivered to seat %s" % args.seat)
        return 0
    if args.print_only:
        print("-> %s" % args.to)
        print(prompt)
        return 0
    cli = find_cli()
    if not cli:
        die("no homi CLI found — cannot reach a brain", 3)
    rc, out = run([cli, "homi", "send", args.to, prompt, "--from", "phone"],
                  timeout=40)
    if rc != 0:
        die("could not deliver to %s: %s" % (args.to, (out or "").strip()), 4)
    print((out or "").strip())
    return 0


def cmd_ptt(args):
    """Post the agent's front door: an ongoing notification whose buttons run
    scripts inside Termux.

    This is the trigger mechanism that actually survives Android. An always-on
    wake word loses to the background-process killer, and the headset button
    only reaches whoever owns the MediaSession — but a notification button is
    event-driven, costs nothing while idle, and works from the lock screen.
    A button action containing $REPLY gets a RemoteInput text box, so the same
    notification is both press-to-talk and type-to-agent.
    """
    # A notification action runs in a MINIMAL shell whose PATH is just
    # $PREFIX/bin — no ~/.local/bin. So the action must carry an ABSOLUTE
    # path, and argv[0] may be a bare name rather than one. (Observed live:
    # the Type button silently did nothing because `phone` was not found.)
    me = shutil.which(sys.argv[0]) or os.path.abspath(sys.argv[0])
    me = os.path.realpath(me)
    # Invoke python explicitly rather than relying on the shebang. Termux has
    # no /usr/bin/env — normally its termux-exec shim rewrites the shebang at
    # exec time, but a notification action can run in a stripped environment
    # where that shim is absent and the script is simply "not found".
    # (Observed live: the Type button failed exactly this way.)
    base = "%s %s" % (sys.executable or "python3", me)
    tail = "--seat %s" % args.seat if args.seat else "--to %s" % args.to
    talk = "%s voice %s" % (base, tail)
    typed = '%s voice %s --text "$REPLY"' % (base, tail)
    argv = ["termux-notification",
            "--title", args.title,
            "--content", args.content,
            "--id", args.id,
            "--ongoing", "--alert-once",
            "--priority", "high",
            # Tapping the BODY must do the obvious thing too. Without this,
            # Android falls back to launching the posting app — which lands
            # the human on Termux:API's info page, looking like a bug.
            "--action", talk,
            "--button1", "Talk", "--button1-action", talk,
            "--button2", "Type", "--button2-action", typed]
    if args.print_only:
        print(" ".join(argv))
        return 0
    need_termux()
    rc, out = run([shutil.which("termux-notification")] + argv[1:], timeout=30)
    if rc != 0:
        die("could not post the notification: %s" % (out or "").strip(), 4)
    print("press-to-talk posted (id=%s)" % args.id)
    return 0



# ----------------------------------------------------------------- watchdog
# Android is hostile to long-lived background work, and a phone is a device
# that wanders between networks and sleeps hard. Everything else here assumes
# the phone is reachable; this is what makes that assumption survivable.
#
# The scheduler matters as much as the checks. A `while true` loop in Termux
# gets killed — that is the whole problem — so the watchdog registers with
# Android's own JobScheduler via termux-job-scheduler, which the OS honours
# and which persists across reboots.

WATCHDOG_STEPS = (
    ("wakelock", "termux-wake-lock",
     "hold the wake-lock so Termux is not reaped while idle"),
    ("sshd", "pgrep -x sshd >/dev/null 2>&1 || sshd",
     "sshd is how the fabric reaches this phone at all"),
    ("daemon", "pgrep -f 'homi.py daemon' >/dev/null 2>&1 || "
               "(HOMI_SELF=${HOMI_SELF:-aadarshs-pixel-10} "
               "XDG_RUNTIME_DIR=$HOME/.local/run nohup python3 "
               "$HOME/.local/share/homi/daemon/current/homi.py daemon "
               ">> $HOME/.local/state/communicate/homi/daemon.log 2>&1 &)",
     "the homi daemon carries mail to and from the agent"),
    ("adb", "adb devices 2>/dev/null | grep -q 'device$' || "
            "adb connect ${ADB_HEAL_IP:-100.95.137.30}:5555 >/dev/null 2>&1",
     "adb is pinned to 5555, so reconnecting is a single dial"),
)


def cmd_watchdog(args):
    if args.install:
        script = os.path.join(os.path.expanduser("~"), ".local", "bin",
                              "phone-watchdog.sh")
        me = shutil.which(sys.argv[0]) or os.path.abspath(sys.argv[0])
        me = os.path.realpath(me)
        body = ("#!/data/data/com.termux/files/usr/bin/sh\n"
                "export PATH=\"$HOME/.local/bin:$PREFIX/bin:$PATH\"\n"
                "%s %s watchdog >> $HOME/.local/state/phone-watchdog.log 2>&1\n"
                % (sys.executable or "python3", me))
        argv = ["termux-job-scheduler",
                "--script", script,
                "--period-ms", str(args.every * 60 * 1000),
                "--persisted", "true",
                "--network", "any"]
        if args.print_only:
            print("write %s:" % script)
            print(body.rstrip())
            print(" ".join(argv))
            return 0
        need_termux()
        try:
            d = os.path.dirname(script)
            if d and not os.path.isdir(d):
                os.makedirs(d, 0o700)
            with open(script, "w") as f:
                f.write(body)
            os.chmod(script, 0o700)
        except OSError as e:
            die("could not write %s (%s)" % (script, e), 4)
        rc, out = run([shutil.which("termux-job-scheduler") or
                       "termux-job-scheduler"] + argv[1:], timeout=30)
        if rc != 0:
            die("could not register the job: %s" % (out or "").strip(), 4)
        record("watchdog", {"every_min": args.every}, "act", "installed")
        print("watchdog registered (every %d min, persisted)" % args.every)
        return 0

    if args.print_only:
        for name, cmd, why in WATCHDOG_STEPS:
            print("%-9s %s" % (name, why))
            print("          %s" % cmd)
        return 0
    need_termux()
    healed = []
    for name, cmd, _why in WATCHDOG_STEPS:
        rc, _out = run(["sh", "-c", cmd], timeout=60)
        if rc != 0:
            healed.append(name + "!")
        else:
            healed.append(name)
    # Only record when something actually needed fixing — a watchdog that
    # writes a line every 15 minutes buries the entries that matter.
    if any(h.endswith("!") for h in healed):
        record("watchdog", " ".join(healed), "act", "healed")
    print(" ".join(healed))
    return 0


def build_parser():
    p = argparse.ArgumentParser(prog="phone", add_help=True,
                                description="drive an Android device as a "
                                            "fabric surface")
    sub = p.add_subparsers(dest="verb")

    def add(name, fn, help_):
        s = sub.add_parser(name, help=help_)
        s.set_defaults(fn=fn)
        return s

    s = add("say", cmd_say, "speak text aloud")
    s.add_argument("text", nargs="+")
    s.add_argument("--timeout", type=int, default=60)

    s = add("listen", cmd_listen, "speech -> text on stdout")
    s.add_argument("--timeout", type=int, default=60)

    s = add("notifs", cmd_notifs, "the universal inbox (all apps)")
    s.add_argument("--app")
    s.add_argument("--since")
    s.add_argument("--limit", type=int, default=0)
    s.add_argument("--json", action="store_true")
    s.add_argument("--from", dest="from_file")

    s = add("ui", cmd_ui, "read the screen as tappable text")
    s.add_argument("--grep")
    s.add_argument("--from", dest="from_file")

    s = add("find", cmd_find, "label -> tap coordinates (or fail loudly)")
    s.add_argument("query", nargs="?")
    s.add_argument("--id", dest="rid", help="match a resource-id instead")
    s.add_argument("--from", dest="from_file")

    s = add("tap", cmd_tap, "tap x y")
    s.add_argument("x", type=int)
    s.add_argument("y", type=int)

    s = add("type", cmd_type, "type text into the focused field")
    s.add_argument("text", nargs="+")

    s = add("key", cmd_key, "send a keyevent (BACK, HOME, ENTER, ...)")
    s.add_argument("key")

    s = add("open", cmd_open, "launch an app or a url")
    s.add_argument("target")
    s.add_argument("--print-url", action="store_true",
                   dest="print_url", help="show the link instead of opening")

    s = add("play", cmd_play, "play music by search query")
    s.add_argument("query", nargs="+")
    s.add_argument("--app")
    s.add_argument("--print-url", action="store_true", dest="print_url")

    s = add("msg", cmd_msg, "message someone (draft, or --send it)")
    s.add_argument("app")
    s.add_argument("--to", required=True)
    s.add_argument("--text", default="")
    s.add_argument("--send", action="store_true",
                   help="actually press send (verified; needs adb)")
    s.add_argument("--print-url", action="store_true", dest="print_url")

    s = add("log", cmd_log, "what the agent has done on this phone")
    s.add_argument("--limit", type=int, default=40)
    s.add_argument("--kind", choices=["act", "read"])
    s.add_argument("--json", action="store_true")

    s = add("media", cmd_media, "pause/play/next/prev/stop")
    s.add_argument("action", choices=["pause", "play", "next", "prev", "stop"])

    s = add("screen", cmd_screen, "screenshot to a png")
    s.add_argument("--out")

    s = add("photo", cmd_photo, "take a photo")
    s.add_argument("--cam", type=int, default=0)
    s.add_argument("--out", default="photo.jpg")

    s = add("torch", cmd_torch, "torch on|off")
    s.add_argument("state", choices=["on", "off"])

    add("battery", cmd_battery, "battery status")

    s = add("where", cmd_where, "location")
    s.add_argument("--provider", default="gps")

    s = add("clip", cmd_clip, "clipboard get|set")
    s.add_argument("action", choices=["get", "set"])
    s.add_argument("text", nargs="*")

    s = add("notify", cmd_notify, "post a notification")
    s.add_argument("title")
    s.add_argument("content")
    s.add_argument("--id", type=int, default=1001)

    s = add("apps", cmd_apps, "installed third-party packages")
    s.add_argument("--grep")

    add("foreground", cmd_foreground, "the app currently on screen")

    s = add("watchdog", cmd_watchdog, "keep this phone reachable")
    s.add_argument("--install", action="store_true",
                   help="register with Android's JobScheduler")
    s.add_argument("--every", type=int, default=15, help="minutes")
    s.add_argument("--print-only", action="store_true", dest="print_only")

    s = add("voice", cmd_voice, "one spoken turn: listen -> a brain -> speak")
    s.add_argument("--to", default="ember", help="agent to think about it")
    s.add_argument("--text", default=None,
                   help="skip the microphone and use this text")
    s.add_argument("--timeout", type=int, default=60)
    s.add_argument("--quiet", action="store_true", help="no spoken ack")
    s.add_argument("--seat", default=None,
                   help="deliver into this tmux target instead of via mail")
    s.add_argument("--print-only", action="store_true", dest="print_only")

    s = add("ptt", cmd_ptt, "post the press-to-talk / type-to-agent notification")
    s.add_argument("--to", default="ember")
    s.add_argument("--seat", default=None)
    s.add_argument("--title", default="ember")
    s.add_argument("--content", default="Talk to your phone")
    s.add_argument("--id", default="phone-voice")
    s.add_argument("--print-only", action="store_true", dest="print_only")
    return p


def main(argv):
    parser = build_parser()
    if len(argv) < 2:
        parser.print_help()
        return 2
    verb = argv[1]
    valid = set(parser._subparsers._group_actions[0].choices) \
        if parser._subparsers else set()
    if verb not in valid and not verb.startswith("-"):
        sys.stderr.write("phone: unknown verb %r\n" % verb)
        sys.stderr.write("try one of: %s\n" % ", ".join(sorted(valid)))
        return 2
    args = parser.parse_args(argv[1:])
    if not getattr(args, "fn", None):
        parser.print_help()
        return 2
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
