# Deep links: the LEVEL-1 path to app control. Android switches wireless
# debugging OFF on a network change or after idle, so anything that matters
# must not need adb. termux-open-url hands a link to Android, which routes it
# to the owning app — same result as `am start`, no adb involved.
LINKS = {
    "ytmusic": "https://music.youtube.com/search?q={q}",
    "youtubemusic": "https://music.youtube.com/search?q={q}",
    "spotify": "https://open.spotify.com/search/{q}",
