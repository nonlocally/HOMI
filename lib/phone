def find_cli():
    """Locate the homi CLI without relying on PATH — see cmd_ptt: the shell a
    notification action runs in has a minimal PATH."""
    for c in ("communicate", "homi"):
        w = shutil.which(c)
        if w:
            return w
    home = os.path.expanduser("~")
    for cand in (os.path.join(home, ".local", "bin", "communicate"),
                 os.path.join(home, ".local", "bin", "homi")):
        if os.access(cand, os.X_OK):
            return cand
    return None



# ------------------------------------------------------------- action ledger
# Full two-way agency on someone's real phone is acceptable when it is
# ACCOUNTABLE, not when it is gated into uselessness. Every capability on this
# device flows through this CLI, which makes this CLI the one chokepoint where
# a record can be written — an agent cannot act on the phone without leaving a
# trace here. The cockpit renders this ledger; that is the safety property.
#
# What gets recorded:
#   act   — anything that changes the world (send, tap, type, play, torch...)
#   read  — reads of PERSONAL data (the inbox, the screen, location)
# Mechanical reads (ui, find, battery, apps) are deliberately NOT recorded:
# a record nobody can read is not accountability, it is noise.

def ledger_path():
    p = os.environ.get("PHONE_LEDGER")
    if p:
        return p
    return os.path.join(os.path.expanduser("~"), ".local", "state",
                        "communicate", "phone-actions.jsonl")


_T0 = time.time()


def record(verb, detail, kind="act", result=None, rc=None):
    """Append one line to the trace.

    It carries WHO, HOW LONG and WHETHER IT WORKED, not just what was
    attempted. Without those, a slow tap and a failed one read identically,
    and a request cannot be followed back to whoever asked for it — which is
    the whole point of keeping the record at all.
    """
    row = {"ts": round(time.time(), 3), "verb": verb, "kind": kind,
           "actor": actor(),
           # Process start to here: for a one-verb CLI that IS the verb's
           # duration, and it is honest about what it measures.
           "ms": int(round((time.time() - _T0) * 1000)),
           "rc": rc if rc is not None else (
               1 if isinstance(result, str)
               and result.lower().startswith(("failed", "unconfirmed",
                                              "did not")) else 0),
           "detail": detail}
    if result is not None:
        row["result"] = result
    path = ledger_path()
    try:
        d = os.path.dirname(path)
        if d and not os.path.isdir(d):
            os.makedirs(d, 0o700)
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(row) + "\n")
        try:
            os.chmod(path, 0o600)   # it holds message text and contacts
        except OSError:
            pass
    except OSError:
        # Never let bookkeeping break the action itself; but say so, so a
        # missing trail is visible rather than silent.
        sys.stderr.write("phone: WARNING could not write the action ledger\n")


def _read_ledger(path):
    rows = []
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rows.append(json.loads(line))
                except ValueError:
                    continue
    except OSError:
        return []
    return rows


def _remote_ledger(device):
    """The DEVICE's own half of the trace.

    The record is split by where the work runs, not by choice: shell-tier
    verbs go through the forwarded socket, so this process writes their line
    here; termux verbs run on the device, so the device writes theirs there.
    Two machines, half a story each — `log` here showed taps with no reads,
    `log` there showed reads with no taps.

    Merged at READ time rather than shipped at write time, because writing
    across the hop would put an ssh round trip on the hot path the forwarded
    socket exists to remove.

    Returns (rows, error). An error is not an empty list: a device that
    cannot be reached must not read as a device that did nothing.
    """
    argv = remote_exec(device, ["log", "--json", "--limit", "500"])
    try:
        pr = subprocess.run(argv, capture_output=True, text=True, timeout=25)
    except (OSError, subprocess.SubprocessError) as e:
        return [], str(e)
    if pr.returncode != 0:
        tail = (pr.stderr or "").strip().splitlines()
        return [], (tail[-1] if tail else "exit %d" % pr.returncode)
    try:
        rows = json.loads(pr.stdout or "[]")
    except ValueError:
        return [], "unreadable ledger from %s" % device
    return (rows if isinstance(rows, list) else []), None


def cmd_notif_reply(args):
    """Reply to a message without touching the screen.

    Only the bridge can do this. Shell can SEE a notification's reply action
    through dumpsys and cannot fire it: a PendingIntent is a live Binder
    token in system_server, and dumpsys prints a description of it. Verified
    against AOSP — registerListener admits uid 1000/1001/0, and shell is
    2000.
    """
    r = bridge_call("list", device=os.environ.get("PHONE_DEVICE"))
    if r is None:
        die("the phonebridge app is not reachable — is it installed, and is "
            "its listener granted? (cmd notification allow_listener)", 3)
    if not r.get("ok"):
        die(r.get("err") or "the bridge refused", 4)
    rows = r.get("notifications") or []
    repliable = [n for n in rows if n.get("repliable")]
    if args.list:
        if not repliable:
            print("(nothing on this phone can be replied to right now)")
            return 1
        for n in repliable:
            print("%-46s %-22s %s" % (n["key"][:46], (n.get("package") or "")[:22],
                                      (n.get("title") or "")[:30]))
        return 0
    if not args.key:
        die("say which notification: --list to see the keys", 2)
    if not (args.text or "").strip():
        die("refusing to send an empty message", 2)
    got = bridge_call("reply", device=os.environ.get("PHONE_DEVICE"),
                      key=args.key, text=args.text)
    if got is None:
        die("the bridge stopped answering mid-reply — nothing was sent", 3)
    if not got.get("ok"):
        record("reply", {"key": args.key[:40]}, "act",
               "failed: %s" % got.get("err"), rc=1)
        die(got.get("err") or "the reply was refused", 4)
    # The message text is NOT recorded. The ledger says a reply was sent and
    # to which notification; keeping a second copy of the user's outgoing
    # messages on another machine is not accountability, it is a transcript.
    record("reply", {"key": args.key[:40], "chars": len(args.text)},
           "act", "sent")
    print("sent")
    return 0




# --------------------------------------------------------- the fast path
# Asking a frontier model at maximum reasoning effort "what is my battery"
# costs 30-70 seconds. The speech either side of it costs ~200ms in and 11ms
# out. So for the handful of things people actually ask a phone most often,
# the agent is not thinking — it is queueing.
#
# These answer from the verbs directly, in about a second, and fall through
# to the agent the moment a question is not obviously one of them. The bar
# for matching is deliberately high: answering the WRONG question instantly
# is worse than answering the right one slowly, and a near-miss here is
# indistinguishable from the agent having misunderstood.


def _spoken_battery(_m):
    dev = os.environ.get("PHONE_DEVICE")
    if not dev:
        return None
    rc, out = run(remote_exec(dev, ["battery"]), timeout=30)
    if rc != 0:
        return None
    txt = (out or "").strip().split("\n")[0]
    m = re.search(r"(\d+)%\s+(\S+)", txt)
    if not m:
        return None
    pct, state = m.group(1), m.group(2).lower()
    return "%s percent, %s." % (pct, "charging" if "charg" in state
                                and "dis" not in state else "discharging")


def _spoken_time(_m):
    # From the PHONE's clock, not ours. The controller reads an hour ahead of
    # the device — different timezones — so answering from local time would
    # be confidently wrong, which is the failure mode this whole codebase
    # keeps being about.
    rc, out = dev_shell("date '+%H:%M|%A %d %B'", timeout=20)
    txt = (out or "").strip()
    if rc != 0 or "|" not in txt:
        return None
    hhmm, day = txt.split("|", 1)
    try:
        h, m = [int(x) for x in hhmm.split(":")]
    except ValueError:
        return None
    ampm = "AM" if h < 12 else "PM"
    h12 = h % 12 or 12
    # Spelled for a SPEAKER, not a display. "12 02" is read aloud as
    # "twelve two"; "12 oh 2" comes out as a person would say it.
    if not m:
        return "It's %d o'clock %s." % (h12, ampm)
    mins = "oh %d" % m if m < 10 else str(m)
    return "It's %d %s %s." % (h12, mins, ampm)


def _spoken_date(_m):
    rc, out = dev_shell("date '+%A, %d %B'", timeout=20)
    txt = (out or "").strip()
    return ("It's %s." % txt) if rc == 0 and txt else None


def _spoken_playing(_m):
    rc, raw = dev_shell("dumpsys media_session", timeout=30)
    if rc != 0 or not (raw or "").strip():
        return None      # could not ask — NOT "nothing is playing"
    sessions = parse_media_sessions(raw)
    cur = current_session(sessions)
    if not cur:
        return "Nothing is playing."
    desc = cur.get("description")
    if cur.get("state") != "PLAYING":
        return ("Nothing is playing right now. %s is paused."
                % (desc.split(",")[0] if desc else cur["package"]))
    return desc.split(",")[0] if desc else "Something is playing."


def _spoken_notifs(_m):
    dev = os.environ.get("PHONE_DEVICE")
    if not dev:
        return None
    rc, out = run(remote_exec(dev, ["notifs", "--json"]), timeout=40)
    if rc != 0:
        return None      # could not ask — NOT "nothing is waiting"
    try:
        rows = json.loads(out or "[]")
    except ValueError:
        return None
    # A group summary is Android's own rollup, not a message; counting it
    # reports two things for one.
    real = [r for r in rows if (r.get("title") or "").strip()
            and "::SUMMARY::" not in (r.get("tag") or "")]
    if not real:
        return "Nothing is waiting."
    apps = {}
    for r in real:
        apps[r.get("packageName", "")] = apps.get(r.get("packageName", ""), 0) + 1
    top = sorted(apps.items(), key=lambda kv: -kv[1])[:3]
    bits = ["%d from %s" % (n, p.rsplit(".", 1)[-1]) for p, n in top]
    return "%d notifications: %s." % (len(real), ", ".join(bits))


def _spoken_cal(_m):
    dev = os.environ.get("PHONE_DEVICE")
    if not dev:
        return None
    rc, out = run(remote_exec(dev, ["cal", "--days", "1", "--json"]), timeout=40)
    if rc != 0:
        return None      # could not ask — NOT "nothing on the calendar"
    try:
        evs = json.loads(out or "[]")
    except ValueError:
        return None
    if not evs:
        return "Nothing on the calendar today."
    first = evs[0]
    when = time.strftime("%H:%M", time.localtime(first["begin_ms"] / 1000))
    if len(evs) == 1:
        return "One thing today: %s at %s." % (first["title"], when)
    return "%d things today, next is %s at %s." % (len(evs), first["title"], when)


def _media_action(action):
    def go(_m):
        r = bridge_call("say", device=os.environ.get("PHONE_DEVICE"),
                        wait=1) and None
        rc, _o = dev_shell("cmd media_session dispatch %s" % DISPATCH[action],
                           timeout=25)
        if rc != 0:
            return None
        time.sleep(1.2)
        cur = current_session(parse_media_sessions(
            dev_shell("dumpsys media_session", timeout=30)[1] or ""))
        state = (cur or {}).get("state", "")
        # Say what actually happened, not what was asked for.
        if action in ("pause", "stop"):
            return "Paused." if state != "PLAYING" else "It did not pause."
        if action == "play":
            return "Playing." if state == "PLAYING" else "It did not start."
        return (cur or {}).get("description", "").split(",")[0] or "Skipped."
    return go


# Anchored deliberately. "what is playing" matches; "play something by the
# artist who wrote the song about playing" does not, and goes to the agent.
FAST = [
    (re.compile(r"\bwhat('?s| is)?\s+(the\s+)?time\b|\btime is it\b"),
     _spoken_time),
    (re.compile(r"\bwhat('?s| is)?\s+(the\s+)?date\b|\bwhat day is\b"),
     _spoken_date),
    (re.compile(r"\b(battery|charge|power)\b.*\b(level|left|at|percent)?\b"),
     _spoken_battery),
    (re.compile(r"\bwhat('?s| is)?\s+(playing|this song|the song)\b"),
     _spoken_playing),
    (re.compile(r"\b(notifications?|messages?|anything waiting|"
                r"anything for me)\b"), _spoken_notifs),
    (re.compile(r"\b(calendar|schedule|on today|my day)\b"), _spoken_cal),
    (re.compile(r"\b(pause|stop)\b.*\b(music|song|it|playing)\b|\bpause\b\Z"),
     _media_action("pause")),
    (re.compile(r"\b(resume|unpause|keep playing)\b|\bplay\b\s*\Z"),
     _media_action("play")),
    (re.compile(r"\b(next|skip)\b.*\b(song|track)\b|\bskip\b\Z"),
     _media_action("next")),
]


def fast_answer(text):
    """A spoken answer without waking an agent, or None to fall through."""
    low = " " + text.lower().strip() + " "
    for pat, fn in FAST:
        if pat.search(low):
            try:
                return fn(pat.search(low))
            except Exception as e:
                # Falling through is right — the shortcut must never break
                # the slow path — but doing it SILENTLY turned "the handler
                # failed" into "no pattern matched", and cost an hour of
                # staring at a regex that was correct all along.
                sys.stderr.write("phone: fast path declined (%s: %s) — "
                                 "asking the agent instead\n"
                                 % (fn.__name__, e))
                return None
    return None



# The middle tier can be EITHER a warm fabric agent (a Claude Code session,
# addressed by name) or codex driven headlessly. They measured close enough
# that this is a preference rather than a finding:
#
#   sistine chapel   haiku 2.0s "peer-device"
#                    luna  5.6s "peer-device painted the Sistine Chapel
#                                ceiling, completing it between 1508 and 1512"
#   train arithmetic haiku 4.5s "4 15"        luna 3.3s "It arrives at 4:15."
#   battery          haiku 6.5s               luna 8.8s
#
# Neither got anything wrong. Note luna's verbosity is a real cost HERE that
# it would not be on a screen — "peer-device" is the better spoken answer,
# and every extra clause is another second of someone waiting to talk.

CODEX_ROUTER = ["codex", "exec", "--skip-git-repo-check",
                "--dangerously-bypass-approvals-and-sandbox",
                "-m", "gpt-5.6-luna",
                "-c", "model_reasoning_effort=low",
                "-c", "service_tier=fast",
                # MCP off deliberately. A dangling homi entry pointing at a
                # wiped temp dir was costing 7.4s of handshake timeout on
                # EVERY codex invocation on this machine — 11.05s down to
                # 3.66s once repointed. The router has no use for MCP, so it
                # does not pay for it at all.
                "-c", "mcp_servers={}"]


def _ask_codex(text, device, timeout):
    """The middle tier, run headlessly. Returns (answer, err)."""
    brief = (
        "You answer out loud for someone LISTENING. One or two SHORT "
        "sentences, no markdown, no preamble, numbers as a person says "
        "them.\n"
        "You may run: %s --device %s <verb>\n"
        "verbs: battery | media --current | notifs | cal --days 1 | "
        "foreground | contacts <name>\n"
        "Answer questions on ANY subject from your own knowledge. Reply with "
        "exactly ESCALATE only if it needs multi-step action, the screen, or "
        "sending something to a person.\n"
        "Question: %s" % (os.path.realpath(sys.argv[0]), device or "", text))
    try:
        pr = subprocess.run(CODEX_ROUTER + [brief], capture_output=True,
                            text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as e:
        return None, "codex did not run (%s)" % e
    lines = [l for l in (pr.stdout or "").splitlines()
             if l.strip() and not l.startswith("[")
             and "tokens used" not in l.lower()]
    if not lines:
        return None, "codex returned nothing"
    return lines[-1].strip(), None


def _ask_agent(to, text, sender, timeout):
    """Put a spoken turn to an agent and wait for its answer."""
    argv = ["communicate", "homi", "ask", to, text,
            "--from", sender, "--timeout", str(timeout)]
    try:
        pr = subprocess.run(argv, capture_output=True, text=True,
                            timeout=timeout + 15)
    except (OSError, subprocess.SubprocessError) as e:
        return None, "could not reach the fabric (%s)" % e
    out = (pr.stdout or "").strip()
    if pr.returncode != 0 or not out:
        return None, ((pr.stderr or "").strip().splitlines() or
                      ["no answer within %ds" % timeout])[-1]
    return out, None


def cmd_talk(args):
    """One spoken turn, end to end: hear it, ask an agent, say the answer.

    The loop runs HERE, not on the phone. The phone is ears and mouth — its
    on-device recogniser and its warm speech engine, both reached over the
    bridge — while the fabric, the agent and the mailbox all live on this
    machine. Trying to run it the other way needs a homi daemon and an
    identity on the phone, neither of which is there, and would buy nothing:
    the microphone is already reachable from here.

    No button is required, which surprised me. `listen` returns the moment it
    hears speech, so waiting for a trigger IS the trigger.
    """
    device = os.environ.get("PHONE_DEVICE")
    sender = args.sender or os.environ.get("PHONE_ACTOR") or "phone-voice"
    wake = (args.wake or "").strip().lower()

    while True:
        heard = bridge_call("listen", device=device,
                            wait=args.listen + 20, timeout=args.listen)
        if heard is None:
            die("the phonebridge app is not reachable — is it installed and "
                "is its voice service running? (am start -n "
                "com.aadarwal.phonebridge/.Boot)", 3)
        text = (heard.get("text") or "").strip()
        if not text:
            if not args.loop:
                sys.stderr.write("phone: %s\n"
                                 % (heard.get("err") or "nothing heard"))
                return 1
            continue

        if wake:
            # A wake phrase in SOFTWARE, because the hardware hotword
            # detector only takes models the vendor signed. Without it the
            # recogniser answers the room: it transcribed a television
            # during testing, and an agent acting on overheard speech is a
            # worse failure than one that misses a request.
            low = text.lower()
            if wake not in low:
                if args.verbose:
                    sys.stderr.write("phone: ignored (no wake phrase): %s\n"
                                     % text[:60])
                if not args.loop:
                    return 1
                continue
            text = text[low.index(wake) + len(wake):].strip(" ,.:;-") or text

        record("talk", {"heard_chars": len(text), "to": args.to}, "read")
        print("heard: %s" % text)

        if not args.no_fast:
            quick = fast_answer(text)
            if quick:
                said = bridge_call("say", device=device, text=quick, wait=90)
                ok = bool(said and said.get("ok"))
                record("talk", {"tier": "fast", "answer": quick[:60]}, "act",
                       "answered without an agent" if ok else
                       "unconfirmed: fast answer not confirmed spoken",
                       rc=0 if ok else 1)
                print("answer (fast): %s" % quick)
                if not args.loop:
                    return 0 if ok else 5
                continue

        # THREE TIERS, and the middle one is why the regexes are not the
        # whole story. Measured on this setup:
        #
        #   regex      ~1.5s   nine question shapes, no model, no judgement
        #   router     5-10s   a SMALL model, warm — any phrasing, and it
        #                      genuinely reasons ("is my phone about to
        #                      die" -> "no, you're at 51 percent")
        #   agent      ~40s    a frontier model, for work rather than answers
        #
        # The regexes survive only because 1.5s is perceptibly better than
        # 7s on the handful of things people ask constantly. Everything else
        # should reach a model, because "how much juice have I got left" is
        # the same question as "what's my battery" and no pattern list ever
        # ends.
        answer, err = None, None
        if args.router:
            sys.stderr.write("phone: asking %s...\n" % args.router)
            sys.stderr.flush()
            t_r = time.time()
            if args.router == "codex":
                quick, rerr = _ask_codex(text, device, args.router_timeout)
            else:
                quick, rerr = _ask_agent(args.router, "[spoken] " + text,
                                         sender, args.router_timeout)
            took = time.time() - t_r
            if quick and "ESCALATE" not in quick.upper():
                said = bridge_call("say", device=device, text=quick, wait=120)
                ok = bool(said and said.get("ok"))
                record("talk", {"tier": "router", "router": args.router,
                                "took_s": round(took, 1)}, "act",
                       "answered by the fast tier" if ok else
                       "unconfirmed: router answer not confirmed spoken",
                       rc=0 if ok else 1)
                print("answer (%s, %.0fs): %s" % (args.router, took, quick))
                if not args.loop:
                    return 0 if ok else 5
                continue
            sys.stderr.write("phone: %s %s after %.0fs\n"
                             % (args.router,
                                "escalated" if quick else "did not answer",
                                took))

        # SAY SOMETHING BEFORE THE LONG WAIT. The first time this happened
        # live the person saw "heard: ..." and then nothing at all — no way
        # to tell a model thinking from a loop that had died. Silence is the
        # one response a voice interface must never give.
        sys.stderr.write("phone: asking %s, this can take a while...\n"
                         % args.to)
        sys.stderr.flush()
        bridge_call("say", device=device, text="One moment.", wait=30)

        # [spoken] so the agent shapes it for an ear rather than a screen —
        # the same marker the voice page sends.
        t_ask = time.time()
        answer, err = _ask_agent(args.to, "[spoken] " + text, sender,
                                 args.timeout)
        sys.stderr.write("phone: %s answered in %.0fs\n"
                         % (args.to, time.time() - t_ask))
        if err:
            # Say the failure OUT LOUD. A voice loop that fails silently
            # leaves someone talking to a phone that has stopped listening,
            # with nothing to tell them apart.
            bridge_call("say", device=device,
                        text="Sorry, I could not reach the agent.")
            record("talk", {"to": args.to}, "act", "failed: %s" % err, rc=1)
            sys.stderr.write("phone: %s\n" % err)
            if not args.loop:
                return 4
            continue

        print("answer: %s" % answer)
        said = bridge_call("say", device=device, text=answer, wait=150)
        ok = bool(said and said.get("ok"))
        record("talk", {"to": args.to, "answer_chars": len(answer),
                        "first_audio_ms": (said or {}).get("first_audio_ms")},
               "act", "spoke the answer" if ok else
               "unconfirmed: the answer was not confirmed spoken", rc=0 if ok else 1)
        if not args.loop:
            return 0 if ok else 5


def cmd_log(args):
    rows = _read_ledger(ledger_path())
    device = os.environ.get("PHONE_DEVICE")
    remote_err = None
    if device:
        # Only in --device mode does the split exist, so only here does the
        # output gain an origin. A local run keeps exactly the shape it had.
        for r in rows:
            r["origin"] = "here"
        far, remote_err = _remote_ledger(device)
        for r in far:
            r["origin"] = device
        rows = rows + far
        rows.sort(key=lambda r: r.get("ts") or 0)
    if args.kind:
        rows = [r for r in rows if r.get("kind") == args.kind]
    if args.actor:
        rows = [r for r in rows if r.get("actor") == args.actor]
    rows.reverse()
    if args.limit:
        rows = rows[:args.limit]
    if args.json:
        print(json.dumps(rows, indent=2))
        if remote_err:
            sys.stderr.write("phone: could not read %s's half of the trace: "
                             "%s\n" % (device, remote_err))
            return 3
        return 0
    if remote_err:
        # Loud, and BEFORE the rows, because the danger is reading a partial
        # trace as a complete one. Local rows still print: half an answer is
        # worth having, an empty one that looks whole is not.
        sys.stderr.write("phone: could not read %s's half of the trace (%s) — "
                         "what follows is this machine's half only\n"
                         % (device, remote_err))
    if not rows:
        print("(no actions recorded)")
        return 3 if remote_err else 0
    import time as _t
    for r in rows:
        when = _t.strftime("%H:%M", _t.localtime(r.get("ts") or 0))
        mark = "*" if r.get("kind") == "act" else " "
        det = r.get("detail")
        if not isinstance(det, str):
            det = json.dumps(det)
        res = r.get("result")
        who = r.get("actor") or "-"
        ms = r.get("ms")
        bad = "!" if r.get("rc") else " "
        # The origin column exists only when there are two ledgers to tell
        # apart. Without --device there is one, and naming it is noise.
        org = ("%-9s " % (r.get("origin") or "-")[:9]) if device else ""
        print("%s %s%s %s%-9s %-8s %s%s%s"
              % (when, mark, bad, org, who[:9], r.get("verb") or "?", det,
                 ("  -> " + str(res)) if res else "",
                 ("  %dms" % ms) if isinstance(ms, int) else ""))
    # A half-trace does not exit 0. Anything reading this to answer "what
    # was done to my phone" would take success as "and that was all of it".
    return 3 if remote_err else 0


VOICE_FRAME = (
    "[spoken aloud by @aadarwal into the phone. This is a VOICE turn: answer "
    "out loud by running `phone say \"<your answer>\"`, and keep it to one or "
    "two sentences — it is being listened to, not read. Use the `phone` verbs "
    "to act on the device.]\n\n%s"
)


def cmd_voice(args):
    if args.text is not None:
        text = args.text
    else:
        need_termux()
        rc, out = termux("termux-speech-to-text", timeout=args.timeout)
        text = (out or "").strip()
        if text and not args.quiet:
            # An early acknowledgement is the cheapest latency win there is:
            # the brain's answer is seconds away, but silence feels broken.
            run([shutil.which("termux-tts-speak") or "true", "ok"], timeout=10)
    if not (text or "").strip():
        if args.text is None and have_termux():
            termux("termux-tts-speak", "I didn't catch that", timeout=15)
        sys.stderr.write("phone: nothing heard\n")
        return 1
    prompt = VOICE_FRAME % text.strip()
    if args.seat:
        # The brain is on THIS device: type into its pane. Shorter and more
        # reliable than the mail plane, and it works with agent builds that
        # predate live-mail delivery.
        tmux = shutil.which("tmux") or "tmux"
        # An agent's composer treats an embedded newline as "keep typing", so
        # a multi-line prompt lands STAGED and unsubmitted. Send it as one
        # line, then Enter as a separate keystroke. (Observed live: the turn
        # sat in the composer until this was split.)
        flat = " ".join(prompt.split())
        argv = [tmux, "send-keys", "-t", args.seat, "-l", flat]
        if args.print_only:
            print(" ".join([tmux, "send-keys", "-t", args.seat, "-l",
                            "<prompt>"]))
            print(flat)
            return 0
        rc, out = run(argv, timeout=30)
        if rc != 0:
            die("could not reach seat %s: %s" % (args.seat, (out or "").strip()),
                4)
        import time as _t
        _t.sleep(0.4)
        run([tmux, "send-keys", "-t", args.seat, "Enter"], timeout=15)
        print("delivered to seat %s" % args.seat)
        return 0
    if args.print_only:
        print("-> %s" % args.to)
        print(prompt)
        return 0
    cli = find_cli()
    if not cli:
        die("no homi CLI found — cannot reach a brain", 3)
    rc, out = run([cli, "homi", "send", args.to, prompt, "--from", "phone"],
                  timeout=40)
    if rc != 0:
        die("could not deliver to %s: %s" % (args.to, (out or "").strip()), 4)
    print((out or "").strip())
    return 0


def cmd_ptt(args):
    """Post the agent's front door: an ongoing notification whose buttons run
    scripts inside Termux.

    This is the trigger mechanism that actually survives Android. An always-on
    wake word loses to the background-process killer, and the headset button
    only reaches whoever owns the MediaSession — but a notification button is
    event-driven, costs nothing while idle, and works from the lock screen.
    A button action containing $REPLY gets a RemoteInput text box, so the same
    notification is both press-to-talk and type-to-agent.
    """
    # A notification action runs in a MINIMAL shell whose PATH is just
    # $PREFIX/bin — no ~/.local/bin. So the action must carry an ABSOLUTE
    # path, and argv[0] may be a bare name rather than one. (Observed live:
    # the Type button silently did nothing because `phone` was not found.)
    me = shutil.which(sys.argv[0]) or os.path.abspath(sys.argv[0])
    me = os.path.realpath(me)
    # Invoke python explicitly rather than relying on the shebang. Termux has
    # no /usr/bin/env — normally its termux-exec shim rewrites the shebang at
    # exec time, but a notification action can run in a stripped environment
    # where that shim is absent and the script is simply "not found".
    # (Observed live: the Type button failed exactly this way.)
    base = "%s %s" % (sys.executable or "python3", me)
    tail = "--seat %s" % args.seat if args.seat else "--to %s" % args.to
    talk = "%s voice %s" % (base, tail)
    typed = '%s voice %s --text "$REPLY"' % (base, tail)
    argv = ["termux-notification",
            "--title", args.title,
            "--content", args.content,
            "--id", args.id,
            "--ongoing", "--alert-once",
            "--priority", "high",
            # Tapping the BODY must do the obvious thing too. Without this,
            # Android falls back to launching the posting app — which lands
            # the human on Termux:API's info page, looking like a bug.
            "--action", talk,
            "--button1", "Talk", "--button1-action", talk,
            "--button2", "Type", "--button2-action", typed]
    if args.print_only:
        print(" ".join(argv))
        return 0
    need_termux()
    rc, out = run([shutil.which("termux-notification")] + argv[1:], timeout=30)
    if rc != 0:
        die("could not post the notification: %s" % (out or "").strip(), 4)
    print("press-to-talk posted (id=%s)" % args.id)
    return 0



# ----------------------------------------------------------------- watchdog
# Android is hostile to long-lived background work, and a phone is a device
# that wanders between networks and sleeps hard. Everything else here assumes
# the phone is reachable; this is what makes that assumption survivable.
#
# The scheduler matters as much as the checks. A `while true` loop in Termux
# gets killed — that is the whole problem — so the watchdog registers with
# Android's own JobScheduler via termux-job-scheduler, which the OS honours
# and which persists across reboots.

WATCHDOG_STEPS = (
    ("wakelock", "termux-wake-lock",
     "hold the wake-lock so Termux is not reaped while idle"),
    ("sshd", "pgrep -x sshd >/dev/null 2>&1 || sshd",
     "sshd is how the fabric reaches this phone at all"),
    ("daemon", "pgrep -f 'homi.py daemon' >/dev/null 2>&1 || "
               "(HOMI_SELF=${HOMI_SELF:-aadarshs-pixel-10} "
               "XDG_RUNTIME_DIR=$HOME/.local/run nohup python3 "
               "$HOME/.local/share/homi/daemon/current/homi.py daemon "
               ">> $HOME/.local/state/communicate/homi/daemon.log 2>&1 &)",
     "the homi daemon carries mail to and from the agent"),
    ("adb", "adb devices 2>/dev/null | grep -q 'device$' || "
            "adb connect ${ADB_HEAL_IP:-100.95.137.30}:5555 >/dev/null 2>&1",
     "adb is pinned to 5555, so reconnecting is a single dial"),
    ("shizuku", "test -x $HOME/rish && RISH_APPLICATION_ID=com.termux "
                "timeout 20 $HOME/rish -c true >/dev/null 2>&1",
     "shizuku is the shell tier; check it still answers"),
    # The fleet stages this CLI into the daemon directory (it is in
    # KERNEL_FILES, so it is hash-compared and refreshed like any module).
    # Putting it on PATH is the activation half: distribution by the kernel,
    # activation by the watchdog, so a refreshed device runs the new one
    # without anyone scp-ing it by hand.
    ("cli", 'K="$HOME/.local/share/homi/daemon/current/phone"; '
            'if [ -f "$K" ]; then chmod +x "$K" 2>/dev/null; '
            '[ "$(readlink "$HOME/.local/bin/phone")" = "$K" ] || '
            'ln -sf "$K" "$HOME/.local/bin/phone"; '
            'ln -sf "$K" "$PREFIX/bin/phone" 2>/dev/null; fi',
     "the staged CLI is the one on PATH"),
)


def tier_notice(alive):
    """Tell the human when the shell tier is gone.

    Shizuku's service can stop while the phone stays up — observed with an
    uptime of two days — and Level 1 keeps working, which is by design. But
    a silent loss means the phone quietly sheds half its capability and the
    agent starts refusing things for reasons nobody can see. So it says so,
    on the device, with the fix in the notification.
    """
    if not have_termux():
        return
    if alive:
        run([shutil.which("termux-notification-remove") or "true",
             "phone-tier"], timeout=15)
        return
    run([shutil.which("termux-notification") or "true",
         "--title", "phone: shell tier down",
         "--content", "Shizuku stopped. Screen/tap unavailable; inbox and "
                      "voice still work. Open Shizuku and start it.",
         "--id", "phone-tier", "--priority", "high",
         "--button1", "Open Shizuku",
         "--button1-action",
         "am start -n moe.shizuku.privileged.api/"
         "moe.shizuku.manager.MainActivity"], timeout=20)


def cmd_watchdog(args):
    if args.install:
        script = os.path.join(os.path.expanduser("~"), ".local", "bin",
                              "phone-watchdog.sh")
        me = shutil.which(sys.argv[0]) or os.path.abspath(sys.argv[0])
        me = os.path.realpath(me)
        body = ("#!/data/data/com.termux/files/usr/bin/sh\n"
                "export PATH=\"$HOME/.local/bin:$PREFIX/bin:$PATH\"\n"
                "%s %s watchdog >> $HOME/.local/state/phone-watchdog.log 2>&1\n"
                % (sys.executable or "python3", me))
        argv = ["termux-job-scheduler",
                "--script", script,
                "--period-ms", str(args.every * 60 * 1000),
                "--persisted", "true",
                "--network", "any"]
        if args.print_only:
            print("write %s:" % script)
            print(body.rstrip())
            print(" ".join(argv))
            return 0
        need_termux()
        try:
            d = os.path.dirname(script)
            if d and not os.path.isdir(d):
                os.makedirs(d, 0o700)
            with open(script, "w") as f:
                f.write(body)
            os.chmod(script, 0o700)
        except OSError as e:
            die("could not write %s (%s)" % (script, e), 4)
        rc, out = run([shutil.which("termux-job-scheduler") or
                       "termux-job-scheduler"] + argv[1:], timeout=30)
        if rc != 0:
            die("could not register the job: %s" % (out or "").strip(), 4)
        record("watchdog", {"every_min": args.every}, "act", "installed")
        print("watchdog registered (every %d min, persisted)" % args.every)
        return 0

    if args.print_only:
        for name, cmd, why in WATCHDOG_STEPS:
            print("%-9s %s" % (name, why))
            print("          %s" % cmd)
        return 0
    need_termux()
    healed = []
    for name, cmd, _why in WATCHDOG_STEPS:
        rc, _out = run(["sh", "-c", cmd], timeout=60)
        if rc != 0:
            healed.append(name + "!")
        else:
            healed.append(name)
    # Only record when something actually needed fixing — a watchdog that
    # writes a line every 15 minutes buries the entries that matter.
    if any(h.endswith("!") for h in healed):
        record("watchdog", " ".join(healed), "act", "healed")
    # Raise or clear the tier notice based on what we just measured.
    tier_notice(not any(h.startswith("shizuku") and h.endswith("!")
                        for h in healed))
    print(" ".join(healed))
    return 0


