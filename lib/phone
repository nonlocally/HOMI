def cmd_type(args):
    # No need_shell() here: --print-only must work with no device, so the
    # exact argv can be inspected and tested off-device.
    import shlex
    text = " ".join(args.text)
    # `input text` mangles multi-word strings: the documented %s-for-space
    # escape silently dropped most of a sentence on this device (measured —
    # "Written by an AI agent over Shizuku" arrived as "iuku"). So: word by
    # word with an explicit SPACE keyevent.
    #
    # Quote with shlex rather than stripping. The old strip-regex deleted
    # apostrophes, =, $, <, >, |, backtick and more, so "Don't" became "Dont"
    # and "x=2" became "x2" — and then it reported success, because it
    # counted WORDS WHOSE EXIT CODE WAS 0, which says nothing about what
    # arrived. An actuator that lies about what it typed is worse than one
    # that fails.
    words = text.split(" ")
    argv = []
    dropped = []
    for w in words:
        # Control characters are the only thing `input text` genuinely cannot
        # carry; everything else survives quoting.
        clean = "".join(c for c in w if c.isprintable())
        if clean != w:
            dropped.append(w)
        argv.append(clean)
    plan = []
    for i, w in enumerate(argv):
        if i:
            plan.append("input keyevent 62")     # KEYCODE_SPACE
        if w:
            plan.append("input text %s" % shlex.quote(w))
    if args.print_only:
        print("\n".join(plan))
        return 0
    need_shell()
    delivered = 0
    for step in plan:
        rc, _ = dev_shell(step)
        if rc != 0:
            break
        if step.startswith("input text "):
            delivered += len(argv[len([p for p in plan[:plan.index(step) + 1]
                                       if p.startswith("input text ")]) - 1])
    want = sum(len(w) for w in argv)
    ok_all = (delivered == want and not dropped)
    record("type", {"requested": text[:200], "sent": " ".join(argv)[:200]},
           "act", "delivered %d/%d chars%s"
           % (delivered, want,
              "; dropped unprintable" if dropped else ""))
    if not ok_all:
        sys.stderr.write("phone: typed %d of %d characters\n"
                         % (delivered, want))
    return 0 if ok_all else 1


def cmd_key(args):
    need_shell()
    k = args.key.upper()
    if not k.startswith("KEYCODE_"):
        k = "KEYCODE_" + k
    if not re.match(r"^KEYCODE_[A-Z0-9_]+$", k):
        die("bad keycode %r" % args.key, 2)
    rc, _ = dev_shell("input keyevent %s" % k)
    record("key", k, "act", "dispatched" if rc == 0 else "failed")
    return 0 if rc == 0 else 1


def launch(url, print_only=False):
    """Level 1: hand a link to Android. No adb, so this keeps working when
    wireless debugging switches itself off."""
    if print_only:
        print(url)
        return 0
    exe = shutil.which("termux-open-url")
    if exe:
        rc, _ = run([exe, url], timeout=30)
        if rc == 0:
            return 0
    # Level 2 fallback, only if adb happens to be up.
    if not os.environ.get("PHONE_NO_DEVICE") and shutil.which("adb") \
            and adb_ready():
        dev_shell("am start -a android.intent.action.VIEW -d %s"
                  % json.dumps(url), timeout=30)
        return 0
    die("could not open %s (Termux:API missing and adb is down)" % url, 3)


def cmd_open(args):
    target = args.target
    if is_url(target):
        return launch(target, args.print_url)
    key = target.strip().lower()
    p = pkg_of(target)
    # LAUNCH the app when we can. The deep link is a fallback for when there
    # is no device shell — asking for "whatsapp" and getting a browser open
    # on wa.me is not what anyone means.
    if p and not have_shell():
        # LEVEL 1 LAUNCH. Measured on-device: `am start -n <component>`
        # succeeds from Termux with shizuku down and adb off, because
        # launching an activity does not need shell UID. Losing the shell
        # tier must not cost app launching — it is the first step of most
        # tasks, and the whole tier design is that level 1 keeps working.
        rc, out = run(["am", "start", "-n", "%s/.MainActivity" % p],
                      timeout=25)
        if rc != 0:
            # Without a shell we cannot resolve the real launcher activity,
            # so fall back to the monitor-free intent form.
            rc, out = run(["am", "start", "-a",
                           "android.intent.action.MAIN", "-c",
                           "android.intent.category.LAUNCHER", "-n", p],
                          timeout=25)
        if rc == 0:
            record("open", target, "act", "opened (level 1, no shell)")
            return 0
        # fall through to the link path below

    if p and have_shell():
        if args.print_url:
            die("%r launches as an app, not a link" % target, 2)
        # Resolve first. `monkey` prints "No activities found to run" for an
        # uninstalled package and still exits 0, so `open whatsapp` reported
        # success on a phone with no WhatsApp — the most common first step of
        # any task, lying. (monkey also injects a random event, which is
        # reason enough to drop it.)
        rc, out = dev_shell(
            "cmd package resolve-activity --brief -c "
            "android.intent.category.LAUNCHER %s | tail -1" % p, timeout=30)
        comp = (out or "").strip().splitlines()[-1].strip() if out else ""
        if rc != 0 or "/" not in comp:
            record("open", target, "act", "failed: not installed")
            die("%s is not installed on this device" % target, 4)
        dev_shell("am start -n %s" % comp, timeout=30)
        # Verify it actually came forward rather than assuming.
        landed = False
        for _ in range(8):
            time.sleep(0.5)
            _rc, fg = dev_shell("dumpsys activity activities | grep -m1 "
                                "ResumedActivity", timeout=20)
            if p in (fg or ""):
                landed = True
                break
        record("open", target, "act", "opened" if landed else "did not open")
        if not landed:
            die("%s did not come to the foreground" % target, 4)
        return 0
    if key in LINKS:
        rc = launch(LINKS[key].replace("{q}", ""), args.print_url)
        if not args.print_url:
            record("open", target, "act", "via link")
        return rc
    if not p:
        pkgs = installed_packages()
        if pkgs:
            near = [x.rsplit(".", 1)[-1] for x in pkgs][:14]
            die("no app matching %r on this device. installed: %s"
                % (target, ", ".join(sorted(set(near)))), 4)
        die("unknown app %r and no device shell to check against" % target, 3)
    die("cannot launch %r: no device shell (start Shizuku)" % target, 3)


def cmd_play(args):
