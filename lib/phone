def main(argv):
    # --device is a GLOBAL: it changes which phone every verb addresses, so
    # it is consumed before the subcommand parser ever sees the arguments.
    argv = list(argv)
    device = os.environ.get("PHONE_DEVICE")
    display = os.environ.get("PHONE_DISPLAY")
    print_link = False
    print_plan = False
    out = []
    i = 1
    while i < len(argv):
        a = argv[i]
        if a == "--device" and i + 1 < len(argv):
            device = argv[i + 1]
            i += 2
            continue
        if a.startswith("--device="):
            device = a.split("=", 1)[1]
            i += 1
            continue
        # --display is a GLOBAL for the same reason --device is: it changes
        # which SCREEN every verb addresses, and the subcommand parsers know
        # nothing about it.
        if a == "--display" and i + 1 < len(argv):
            display = argv[i + 1]
            i += 2
            continue
        if a.startswith("--display="):
            display = a.split("=", 1)[1]
            i += 1
            continue
        if a == "--print-link":
            print_link = True
            i += 1
            continue
        if a == "--print-plan":
            print_plan = True
            i += 1
            continue
        out.append(a)
        i += 1
    argv = [argv[0]] + out

    if display not in (None, ""):
        try:
            _DISPLAY[0] = int(display)
        except ValueError:
            die("--display wants a display id (see `phone display ls`)", 2)
        if _DISPLAY[0]:
            # So a verb that hops to the device carries the same screen, and
            # so anything this process spawns inherits it.
            os.environ["PHONE_DISPLAY"] = str(_DISPLAY[0])

    if print_link:
        if not device:
            die("--print-link needs --device", 2)
        print(" ".join(link_argv(device, local_sock_for(device))))
        return 0

    verb0 = out[0] if out else ""
    # Publish the chosen device so verbs that need to know WHICH phone they
    # are talking about — `log`, which has to fetch that device's half of the
    # split trace — can see it without threading it through every signature.
    if device:
        os.environ["PHONE_DEVICE"] = device
    # ...unless a display was named. The remote hop exists because a PNG
    # cannot cross shelld, but a virtual display's PNG comes from the holder
    # over ssh anyway — and the device's own `phone` may well be an older
    # build that has never heard of --display, in which case hopping turns a
    # working capture into "unrecognized arguments".
    if device and verb0 in BINARY_VERBS and not display_id():
        # Pull our own --out aside: the device streams to ITS stdout, and the
        # file is written HERE. Leaving --out in the remote argv would write
        # a screenshot onto the phone and print a path that does not exist
        # on the machine holding it.
        local_out, rest, i = "screen.png", [], 1
        while i < len(out):
            if out[i] == "--out" and i + 1 < len(out):
                local_out = out[i + 1]
                i += 2
                continue
            if out[i].startswith("--out="):
                local_out = out[i].split("=", 1)[1]
                i += 1
                continue
            rest.append(out[i])
            i += 1
        argv_r = remote_exec(device, [verb0] + rest + ["--out", "-"])
        if print_plan:
            print("run on the device, streaming bytes home: %s"
                  % " ".join(argv_r))
            return 0
        pr = subprocess.run(argv_r, capture_output=True, timeout=180)
        if pr.returncode != 0 or not pr.stdout:
            sys.stderr.write((pr.stderr or b"").decode("utf-8", "replace")
                             or "phone: %s produced nothing on %s\n"
                             % (verb0, device))
            return pr.returncode or 4
        # It has to LOOK like an image. Anything on that stdout is non-empty
        # — an ssh banner, a known-hosts warning, a shell diagnostic — and
        # writing those to screen.png would hand back a "screenshot" that no
        # viewer can open, reported as a success with a path.
        if not pr.stdout.startswith(PNG_MAGIC):
            head = pr.stdout[:120].decode("utf-8", "replace").strip()
            sys.stderr.write("phone: %s did not return an image (got %r) — "
                             "nothing written\n" % (verb0, head))
            return 4
        if local_out == "-":
            sys.stdout.buffer.write(pr.stdout)
            sys.stdout.buffer.flush()
            return 0
        with open(local_out, "wb") as f:
            f.write(pr.stdout)
        print(local_out)
        return 0
    if device and verb0 in TERMUX_VERBS:
        argv_r = remote_exec(device, out)
        if print_plan:
            print("run on the device (termux-api, not shell): %s"
                  % " ".join(argv_r))
            return 0
        r = subprocess.run(argv_r, timeout=180)
        return r.returncode
    if print_plan:
        if not device:
            die("--print-plan needs --device", 2)
        print("run here against the forwarded socket %s"
              % local_sock_for(device))
        return 0
    # `log` reads files; it has no business standing up a device shell. Doing
    # so made an unreachable phone hide the half of the trace that lives on
    # THIS machine — the half that is still perfectly readable, and the half
    # you most want when the device has gone quiet.
    if device and verb0 not in NO_LINK_VERBS:
        ensure_link(device)

    parser = build_parser()
    if len(argv) < 2:
        parser.print_help()
        return 2

    verb = argv[1]
    valid = set(parser._subparsers._group_actions[0].choices) \
        if parser._subparsers else set()
    if verb not in valid and not verb.startswith("-"):
        sys.stderr.write("phone: unknown verb %r\n" % verb)
        sys.stderr.write("try one of: %s\n" % ", ".join(sorted(valid)))
        return 2
    args = parser.parse_args(argv[1:])
    if not getattr(args, "fn", None):
        parser.print_help()
        return 2
    # Gate here, not in the daemon: open/play/say/photo/torch are termux-api
    # and never reach shelld, so a daemon-side gate would leave exactly the
    # verbs that touch the outside world unguarded.
    lease_check(verb)
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
