    query = " ".join(args.query)
    app = (args.app or "ytmusic").strip().lower()
    tmpl = LINKS.get(app)
    if not tmpl or "{q}" not in tmpl:
        die("cannot search in %r — try ytmusic, spotify, or youtube" % app, 2)
    if not args.print_url:
        record("play", query, "act")
    return launch(tmpl.replace("{q}", quote_plus(query)), args.print_url)


SEND_IDS = ("com.whatsapp:id/send", "com.whatsapp:id/send_container")


def cmd_msg(args):
    """Open a chat with the message prefilled, and — with --send — press send.

    Two-way is the point: an assistant that can only draft is a notepad. What
    makes it safe is not a permission prompt on every message but the ledger:
    the send is recorded here, at the chokepoint, whether or not anyone is
    watching. --send additionally VERIFIES rather than assuming: it re-reads
    the screen and reports honestly if the message did not go.
    """
    from urllib.parse import quote
    app = args.app.strip().lower()
    if app != "whatsapp":
        die("msg currently supports whatsapp only", 2)
    num = re.sub(r"[^\d]", "", args.to or "")
    if not num:
        die("--to must be a phone number in international form", 2)
    url = "https://wa.me/%s" % num
    if args.text:
        url += "?text=%s" % quote(args.text, safe="")
    if args.print_url:
        return launch(url, True)
    if not args.send:
        rc = launch(url, False)          # dies loudly if it cannot open
        record("msg", {"app": app, "to": num, "text": args.text,
                       "sent": False}, "act", "drafted")
        return rc

    # --send needs to TOUCH the screen, which only the adb tier can do.
    if not have_shell():
        record("msg", {"app": app, "to": num, "text": args.text,
                       "sent": False}, "act", "failed: no device shell")
        die("cannot send: no device shell, so the send button cannot be "
            "pressed. Start Shizuku. (Refusing to report a send that did not "
            "happen.)", 3)
    launch(url, False)
    import time as _t
    deadline = _t.time() + 25
    # Only ever press send while WhatsApp is actually in front. The
    # content-desc fallback below ("Send") is not namespaced to any app, so
    # without this a stray overlay, another chat app, or a share sheet could
    # supply the button we tap.
    fg_ok = False
    while _t.time() < deadline and not fg_ok:
        rc, out = dev_shell("dumpsys activity activities", timeout=30)
        if "com.whatsapp" in (out or ""):
            fg_ok = True
            break
        _t.sleep(1.0)
    if not fg_ok:
        record("msg", {"app": app, "to": num, "text": args.text,
                       "sent": False}, "act", "failed: chat never opened")
        die("cannot send: WhatsApp never came to the foreground. "
            "Nothing was sent.", 4)
    coords = None
    while _t.time() < deadline:
        _t.sleep(1.5)
        try:
            els = parse_ui(get_ui(None))
        except SystemExit:
            continue
        for el in els:
            if el.rid in SEND_IDS or (el.desc or "").strip().lower() == "send":
                tgt = clickable_target(el)
                if tgt is not None:
                    coords = tgt.center
                    break
        if coords:
            break
    if not coords:
        record("msg", {"app": app, "to": num, "text": args.text,
                       "sent": False}, "act", "failed: no send button")
        die("cannot send: never found the send button (the chat may not have "
            "opened). Nothing was sent.", 4)
    dev_shell("input tap %d %d" % coords)
    _t.sleep(2.0)
    # Verify rather than assume: after a send the composer empties, so the
    # send affordance disappears. If it is still there, the tap did not take.
    still = False
    try:
        for el in parse_ui(get_ui(None)):
            if el.rid in SEND_IDS or (el.desc or "").strip().lower() == "send":
                still = True
                break
    except SystemExit:
        still = False
    if still:
        record("msg", {"app": app, "to": num, "text": args.text,
                       "sent": False}, "act", "unconfirmed")
        sys.stderr.write("phone: tapped send but the composer still looks "
                         "full — treat as UNSENT and check the thread\n")
        return 1
    record("msg", {"app": app, "to": num, "text": args.text, "sent": True},
           "act", "sent")
    print("sent to %s" % num)
    return 0


