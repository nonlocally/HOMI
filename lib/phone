def find_cli():
    """Locate the homi CLI without relying on PATH — see cmd_ptt: the shell a
    notification action runs in has a minimal PATH."""
    for c in ("communicate", "homi"):
        w = shutil.which(c)
        if w:
            return w
    home = os.path.expanduser("~")
    for cand in (os.path.join(home, ".local", "bin", "communicate"),
                 os.path.join(home, ".local", "bin", "homi")):
        if os.access(cand, os.X_OK):
            return cand
    return None



# ------------------------------------------------------------- action ledger
# Full two-way agency on someone's real phone is acceptable when it is
# ACCOUNTABLE, not when it is gated into uselessness. Every capability on this
# device flows through this CLI, which makes this CLI the one chokepoint where
# a record can be written — an agent cannot act on the phone without leaving a
# trace here. The cockpit renders this ledger; that is the safety property.
#
# What gets recorded:
#   act   — anything that changes the world (send, tap, type, play, torch...)
#   read  — reads of PERSONAL data (the inbox, the screen, location)
# Mechanical reads (ui, find, battery, apps) are deliberately NOT recorded:
# a record nobody can read is not accountability, it is noise.

def ledger_path():
    p = os.environ.get("PHONE_LEDGER")
    if p:
        return p
    return os.path.join(os.path.expanduser("~"), ".local", "state",
                        "communicate", "phone-actions.jsonl")


_T0 = time.time()


def record(verb, detail, kind="act", result=None, rc=None):
    """Append one line to the trace.

    It carries WHO, HOW LONG and WHETHER IT WORKED, not just what was
    attempted. Without those, a slow tap and a failed one read identically,
    and a request cannot be followed back to whoever asked for it — which is
    the whole point of keeping the record at all.
    """
    row = {"ts": round(time.time(), 3), "verb": verb, "kind": kind,
           "actor": actor(),
           # Process start to here: for a one-verb CLI that IS the verb's
           # duration, and it is honest about what it measures.
           "ms": int(round((time.time() - _T0) * 1000)),
           "rc": rc if rc is not None else (
               1 if isinstance(result, str)
               and result.lower().startswith(("failed", "unconfirmed",
                                              "did not")) else 0),
           "detail": detail}
    if result is not None:
        row["result"] = result
    path = ledger_path()
    try:
        d = os.path.dirname(path)
        if d and not os.path.isdir(d):
            os.makedirs(d, 0o700)
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(row) + "\n")
        try:
            os.chmod(path, 0o600)   # it holds message text and contacts
        except OSError:
            pass
    except OSError:
        # Never let bookkeeping break the action itself; but say so, so a
        # missing trail is visible rather than silent.
        sys.stderr.write("phone: WARNING could not write the action ledger\n")


def cmd_log(args):
    path = ledger_path()
    rows = []
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rows.append(json.loads(line))
                except ValueError:
                    continue
    except OSError:
        rows = []
    if args.kind:
        rows = [r for r in rows if r.get("kind") == args.kind]
    if args.actor:
        rows = [r for r in rows if r.get("actor") == args.actor]
    rows.reverse()
    if args.limit:
        rows = rows[:args.limit]
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    if not rows:
        print("(no actions recorded)")
        return 0
    import time as _t
    for r in rows:
        when = _t.strftime("%H:%M", _t.localtime(r.get("ts") or 0))
        mark = "*" if r.get("kind") == "act" else " "
        det = r.get("detail")
        if not isinstance(det, str):
            det = json.dumps(det)
        res = r.get("result")
        who = r.get("actor") or "-"
        ms = r.get("ms")
        bad = "!" if r.get("rc") else " "
        print("%s %s%s %-9s %-8s %s%s%s"
              % (when, mark, bad, who[:9], r.get("verb") or "?", det,
                 ("  -> " + str(res)) if res else "",
                 ("  %dms" % ms) if isinstance(ms, int) else ""))
    return 0


VOICE_FRAME = (
    "[spoken aloud by @aadarwal into the phone. This is a VOICE turn: answer "
    "out loud by running `phone say \"<your answer>\"`, and keep it to one or "
    "two sentences — it is being listened to, not read. Use the `phone` verbs "
    "to act on the device.]\n\n%s"
)


def cmd_voice(args):
    if args.text is not None:
        text = args.text
    else:
        need_termux()
        rc, out = termux("termux-speech-to-text", timeout=args.timeout)
        text = (out or "").strip()
        if text and not args.quiet:
            # An early acknowledgement is the cheapest latency win there is:
            # the brain's answer is seconds away, but silence feels broken.
            run([shutil.which("termux-tts-speak") or "true", "ok"], timeout=10)
    if not (text or "").strip():
        if args.text is None and have_termux():
            termux("termux-tts-speak", "I didn't catch that", timeout=15)
        sys.stderr.write("phone: nothing heard\n")
        return 1
    prompt = VOICE_FRAME % text.strip()
    if args.seat:
        # The brain is on THIS device: type into its pane. Shorter and more
        # reliable than the mail plane, and it works with agent builds that
        # predate live-mail delivery.
        tmux = shutil.which("tmux") or "tmux"
        # An agent's composer treats an embedded newline as "keep typing", so
        # a multi-line prompt lands STAGED and unsubmitted. Send it as one
        # line, then Enter as a separate keystroke. (Observed live: the turn
        # sat in the composer until this was split.)
        flat = " ".join(prompt.split())
        argv = [tmux, "send-keys", "-t", args.seat, "-l", flat]
        if args.print_only:
            print(" ".join([tmux, "send-keys", "-t", args.seat, "-l",
                            "<prompt>"]))
            print(flat)
            return 0
        rc, out = run(argv, timeout=30)
        if rc != 0:
            die("could not reach seat %s: %s" % (args.seat, (out or "").strip()),
                4)
        import time as _t
        _t.sleep(0.4)
        run([tmux, "send-keys", "-t", args.seat, "Enter"], timeout=15)
        print("delivered to seat %s" % args.seat)
        return 0
    if args.print_only:
        print("-> %s" % args.to)
        print(prompt)
        return 0
    cli = find_cli()
    if not cli:
        die("no homi CLI found — cannot reach a brain", 3)
    rc, out = run([cli, "homi", "send", args.to, prompt, "--from", "phone"],
                  timeout=40)
    if rc != 0:
        die("could not deliver to %s: %s" % (args.to, (out or "").strip()), 4)
    print((out or "").strip())
    return 0


def cmd_ptt(args):
    """Post the agent's front door: an ongoing notification whose buttons run
    scripts inside Termux.

    This is the trigger mechanism that actually survives Android. An always-on
    wake word loses to the background-process killer, and the headset button
    only reaches whoever owns the MediaSession — but a notification button is
    event-driven, costs nothing while idle, and works from the lock screen.
    A button action containing $REPLY gets a RemoteInput text box, so the same
    notification is both press-to-talk and type-to-agent.
    """
    # A notification action runs in a MINIMAL shell whose PATH is just
    # $PREFIX/bin — no ~/.local/bin. So the action must carry an ABSOLUTE
    # path, and argv[0] may be a bare name rather than one. (Observed live:
    # the Type button silently did nothing because `phone` was not found.)
    me = shutil.which(sys.argv[0]) or os.path.abspath(sys.argv[0])
    me = os.path.realpath(me)
    # Invoke python explicitly rather than relying on the shebang. Termux has
    # no /usr/bin/env — normally its termux-exec shim rewrites the shebang at
    # exec time, but a notification action can run in a stripped environment
    # where that shim is absent and the script is simply "not found".
    # (Observed live: the Type button failed exactly this way.)
    base = "%s %s" % (sys.executable or "python3", me)
    tail = "--seat %s" % args.seat if args.seat else "--to %s" % args.to
    talk = "%s voice %s" % (base, tail)
    typed = '%s voice %s --text "$REPLY"' % (base, tail)
    argv = ["termux-notification",
            "--title", args.title,
            "--content", args.content,
            "--id", args.id,
            "--ongoing", "--alert-once",
            "--priority", "high",
            # Tapping the BODY must do the obvious thing too. Without this,
            # Android falls back to launching the posting app — which lands
            # the human on Termux:API's info page, looking like a bug.
            "--action", talk,
            "--button1", "Talk", "--button1-action", talk,
            "--button2", "Type", "--button2-action", typed]
    if args.print_only:
        print(" ".join(argv))
        return 0
    need_termux()
    rc, out = run([shutil.which("termux-notification")] + argv[1:], timeout=30)
    if rc != 0:
        die("could not post the notification: %s" % (out or "").strip(), 4)
    print("press-to-talk posted (id=%s)" % args.id)
    return 0



# ----------------------------------------------------------------- watchdog
# Android is hostile to long-lived background work, and a phone is a device
# that wanders between networks and sleeps hard. Everything else here assumes
# the phone is reachable; this is what makes that assumption survivable.
#
# The scheduler matters as much as the checks. A `while true` loop in Termux
# gets killed — that is the whole problem — so the watchdog registers with
# Android's own JobScheduler via termux-job-scheduler, which the OS honours
# and which persists across reboots.

WATCHDOG_STEPS = (
    ("wakelock", "termux-wake-lock",
     "hold the wake-lock so Termux is not reaped while idle"),
    ("sshd", "pgrep -x sshd >/dev/null 2>&1 || sshd",
     "sshd is how the fabric reaches this phone at all"),
    ("daemon", "pgrep -f 'homi.py daemon' >/dev/null 2>&1 || "
               "(HOMI_SELF=${HOMI_SELF:-aadarshs-pixel-10} "
               "XDG_RUNTIME_DIR=$HOME/.local/run nohup python3 "
               "$HOME/.local/share/homi/daemon/current/homi.py daemon "
               ">> $HOME/.local/state/communicate/homi/daemon.log 2>&1 &)",
     "the homi daemon carries mail to and from the agent"),
    ("adb", "adb devices 2>/dev/null | grep -q 'device$' || "
            "adb connect ${ADB_HEAL_IP:-100.95.137.30}:5555 >/dev/null 2>&1",
     "adb is pinned to 5555, so reconnecting is a single dial"),
    ("shizuku", "test -x $HOME/rish && RISH_APPLICATION_ID=com.termux "
                "timeout 20 $HOME/rish -c true >/dev/null 2>&1",
     "shizuku is the shell tier; check it still answers"),
    # The fleet stages this CLI into the daemon directory (it is in
    # KERNEL_FILES, so it is hash-compared and refreshed like any module).
    # Putting it on PATH is the activation half: distribution by the kernel,
    # activation by the watchdog, so a refreshed device runs the new one
    # without anyone scp-ing it by hand.
    ("cli", 'K="$HOME/.local/share/homi/daemon/current/phone"; '
            'if [ -f "$K" ]; then chmod +x "$K" 2>/dev/null; '
            '[ "$(readlink "$HOME/.local/bin/phone")" = "$K" ] || '
            'ln -sf "$K" "$HOME/.local/bin/phone"; '
            'ln -sf "$K" "$PREFIX/bin/phone" 2>/dev/null; fi',
     "the staged CLI is the one on PATH"),
)


def tier_notice(alive):
    """Tell the human when the shell tier is gone.

    Shizuku's service can stop while the phone stays up — observed with an
    uptime of two days — and Level 1 keeps working, which is by design. But
    a silent loss means the phone quietly sheds half its capability and the
    agent starts refusing things for reasons nobody can see. So it says so,
    on the device, with the fix in the notification.
    """
    if not have_termux():
        return
    if alive:
        run([shutil.which("termux-notification-remove") or "true",
             "phone-tier"], timeout=15)
        return
    run([shutil.which("termux-notification") or "true",
         "--title", "phone: shell tier down",
         "--content", "Shizuku stopped. Screen/tap unavailable; inbox and "
                      "voice still work. Open Shizuku and start it.",
         "--id", "phone-tier", "--priority", "high",
         "--button1", "Open Shizuku",
         "--button1-action",
         "am start -n moe.shizuku.privileged.api/"
         "moe.shizuku.manager.MainActivity"], timeout=20)


def cmd_watchdog(args):
    if args.install:
        script = os.path.join(os.path.expanduser("~"), ".local", "bin",
                              "phone-watchdog.sh")
        me = shutil.which(sys.argv[0]) or os.path.abspath(sys.argv[0])
        me = os.path.realpath(me)
        body = ("#!/data/data/com.termux/files/usr/bin/sh\n"
                "export PATH=\"$HOME/.local/bin:$PREFIX/bin:$PATH\"\n"
                "%s %s watchdog >> $HOME/.local/state/phone-watchdog.log 2>&1\n"
                % (sys.executable or "python3", me))
        argv = ["termux-job-scheduler",
                "--script", script,
                "--period-ms", str(args.every * 60 * 1000),
                "--persisted", "true",
                "--network", "any"]
        if args.print_only:
            print("write %s:" % script)
            print(body.rstrip())
            print(" ".join(argv))
            return 0
        need_termux()
        try:
            d = os.path.dirname(script)
            if d and not os.path.isdir(d):
                os.makedirs(d, 0o700)
            with open(script, "w") as f:
                f.write(body)
            os.chmod(script, 0o700)
        except OSError as e:
            die("could not write %s (%s)" % (script, e), 4)
        rc, out = run([shutil.which("termux-job-scheduler") or
                       "termux-job-scheduler"] + argv[1:], timeout=30)
        if rc != 0:
            die("could not register the job: %s" % (out or "").strip(), 4)
        record("watchdog", {"every_min": args.every}, "act", "installed")
        print("watchdog registered (every %d min, persisted)" % args.every)
        return 0

    if args.print_only:
        for name, cmd, why in WATCHDOG_STEPS:
            print("%-9s %s" % (name, why))
            print("          %s" % cmd)
        return 0
    need_termux()
    healed = []
    for name, cmd, _why in WATCHDOG_STEPS:
        rc, _out = run(["sh", "-c", cmd], timeout=60)
        if rc != 0:
            healed.append(name + "!")
        else:
            healed.append(name)
    # Only record when something actually needed fixing — a watchdog that
    # writes a line every 15 minutes buries the entries that matter.
    if any(h.endswith("!") for h in healed):
        record("watchdog", " ".join(healed), "act", "healed")
    # Raise or clear the tier notice based on what we just measured.
    tier_notice(not any(h.startswith("shizuku") and h.endswith("!")
                        for h in healed))
    print(" ".join(healed))
    return 0


def build_parser():
    p = argparse.ArgumentParser(prog="phone", add_help=True,
                                description="drive an Android device as a "
                                            "fabric surface")
    sub = p.add_subparsers(dest="verb")

    def add(name, fn, help_):
        s = sub.add_parser(name, help=help_)
        s.set_defaults(fn=fn)
        return s

    s = add("say", cmd_say, "speak text aloud")
    s.add_argument("text", nargs="+")
    s.add_argument("--timeout", type=int, default=60)

    s = add("listen", cmd_listen, "speech -> text on stdout")
    s.add_argument("--timeout", type=int, default=60)

    s = add("notifs", cmd_notifs, "the universal inbox (all apps)")
    s.add_argument("--app")
    s.add_argument("--since")
    s.add_argument("--limit", type=int, default=0)
    s.add_argument("--json", action="store_true")
    s.add_argument("--from", dest="from_file")

    s = add("ui", cmd_ui, "read the screen as tappable text")
    s.add_argument("--grep")
    s.add_argument("--from", dest="from_file")

    s = add("look", cmd_look, "the screen, summarised for an agent")
    s.add_argument("--limit", type=int, default=40)
    s.add_argument("--all", action="store_true",
                   help="include things that cannot be tapped")
    s.add_argument("--from", dest="from_file")

    s = add("find", cmd_find, "label -> tap coordinates (or fail loudly)")
    s.add_argument("query", nargs="?")
    s.add_argument("--id", dest="rid", help="match a resource-id instead")
    s.add_argument("--from", dest="from_file")

    s = add("tap", cmd_tap, "tap x y")
    s.add_argument("x", type=int)
    s.add_argument("y", type=int)

    s = add("type", cmd_type, "type text into the focused field")
    s.add_argument("text", nargs="+")
    s.add_argument("--print-only", action="store_true", dest="print_only",
                   help="show the exact input-text argv instead of typing")

    s = add("key", cmd_key, "send a keyevent (BACK, HOME, ENTER, ...)")
    s.add_argument("key")

    s = add("open", cmd_open, "launch an app or a url")
    s.add_argument("target")
    s.add_argument("--print-url", action="store_true",
