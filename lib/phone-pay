#!/usr/bin/env python3
"""phone-pay — mint a one-time card on THIS device and put it into the screen,
without the number ever becoming an argument, a log line, or agent context.

Why this exists as its own program, running here rather than on a controller:

  * The Link token is in Termux app-private storage (mode 0700, SELinux
    app_data_file with per-app MLS categories). A shell-uid process — which is
    what `phone sh` and every screen verb run as — cannot read it. Measured:
    `cat` of the config from uid 2000 is Permission denied, and so is a bare
    `ls` of /data/data/com.termux. So the mint has to happen at the Termux uid,
    which means on the phone, which means here.

  * The moment a PAN is a command-line argument it exists in three durable
    places nobody meant to write it to: the agent's transcript, the phone
    action ledger (`record()` stores detail.requested verbatim), and any shell
    history in between. The fix is not to redact those; it is to never let the
    number be an argument. The agent asks for a card and then fills fields BY
    NAME. It never learns a digit.

The interface is deliberately four small verbs rather than one that does
everything, because a checkout form is filled one focused field at a time and
the agent — not this program — is the thing that knows which field is focused.

    phone-pay mint  --amount 4200 --merchant "..." --context "..."
    phone-pay await                     # blocks until the human decides
    phone-pay fill number               # types into the focused input
    phone-pay done                      # shreds the credential

Everything this program prints is safe to put in a transcript. That is the
single invariant; if you change one line here, keep that one.
"""
import argparse
import calendar
import json
import os
import re
import shlex
import subprocess
import sys
import time

VAULT_DIR = os.path.join(os.path.expanduser("~"), ".local", "state",
                         "communicate", "phone-pay")
VAULT = os.path.join(VAULT_DIR, "vault.json")
LEDGER = os.path.join(os.path.expanduser("~"), ".local", "state",
                      "communicate", "phone-actions.jsonl")

# Fields an agent may ask for by name. The value side is resolved from the
# vault at fill time and never returned to the caller.
FIELDS = {
    "number": ("card", "number"),
    "cvc": ("card", "cvc"),
    "exp": None,            # computed MM/YY
    "exp_month": ("card", "exp_month"),
    "exp_year": ("card", "exp_year"),
    "zip": ("card", "billing_address", "postal_code"),
    "name": ("card", "billing_address", "name"),
    "line1": ("card", "billing_address", "line1"),
    "city": ("card", "billing_address", "city"),
    "state": ("card", "billing_address", "state"),
    "country": ("card", "billing_address", "country"),
}


def die(msg, code=2):
    sys.stderr.write("phone-pay: %s\n" % msg)
    raise SystemExit(code)


def run(argv, timeout=120, stdin=None):
    try:
        p = subprocess.run(argv, capture_output=True, text=True,
                           timeout=timeout, input=stdin)
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired:
        return 124, "", "timed out"
    except FileNotFoundError:
        return 127, "", "not found"


def record(verb, detail, result=None):
    """One ledger line. Never carries a digit of the credential — the whole
    point of this program is undone if it does."""
    row = {"ts": round(time.time(), 3), "verb": verb, "kind": "act",
           "actor": os.environ.get("PHONE_ACTOR", "anon"), "detail": detail}
    if result is not None:
        row["result"] = result
    try:
        os.makedirs(os.path.dirname(LEDGER), 0o700, exist_ok=True)
        with open(LEDGER, "a", encoding="utf-8") as f:
            f.write(json.dumps(row) + "\n")
        os.chmod(LEDGER, 0o600)
    except OSError:
        sys.stderr.write("phone-pay: WARNING could not write the ledger\n")


def on_device():
    return os.path.isdir("/data/data/com.termux/files/home")


def need_device():
    if not on_device():
        die("this must run ON the phone, as the Termux user.\n"
            "  The Link token lives in Termux app-private storage and no other\n"
            "  uid can read it. From a controller, reach it over ssh:\n"
            "      ssh <device> 'phone-pay ...'", 3)


def link(*args, timeout=120):
    """Call link-cli and parse its JSON. Its agent mode emits a LIST of yields;
    the last one is the settled state."""
    rc, out, err = run(["link-cli"] + list(args) + ["--format", "json"],
                       timeout=timeout)
    if rc == 127:
        die("link-cli is not installed on this device "
            "(npm install -g @stripe/link-cli)", 3)
    text = (out or "").strip()
    if not text:
        die("link-cli returned nothing (%s)" % (err or "rc=%d" % rc).strip(), 3)
    try:
        d = json.loads(text)
    except ValueError:
        die("link-cli did not return JSON: %s" % text[:200], 3)
    if isinstance(d, list):
        if not d:
            die("link-cli returned an empty result", 3)
        d = d[-1]
    if isinstance(d, dict) and d.get("code") and d.get("message"):
        die("link: %s" % d["message"], 4)
    return d


def notify(title, content):
    """Post the approval on the phone itself. Best effort and never fatal:
    the URL is also on stdout, which is the channel the caller actually reads.
    This exists because there is no push today — see the skill."""
    try:
        run(["termux-notification", "--title", title, "--content", content,
             "--id", "phone-pay", "--priority", "high"], timeout=15)
    except Exception:
        pass


# ------------------------------------------------------------------ the vault
def vault_read():
    if not os.path.exists(VAULT):
        die("no card held. Run `phone-pay mint` first.", 5)
    with open(VAULT, "r", encoding="utf-8") as f:
        return json.load(f)


def vault_write(d):
    os.makedirs(VAULT_DIR, 0o700, exist_ok=True)
    tmp = VAULT + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(d, f)
    os.replace(tmp, VAULT)
    os.chmod(VAULT, 0o600)


def vault_shred():
    """Overwrite before unlinking. On flash this is not a guarantee — the FTL
    may keep the old block — but it costs nothing and removes the value from
    anything that reads the file by path."""
    if not os.path.exists(VAULT):
        return False
    try:
        n = os.path.getsize(VAULT)
        with open(VAULT, "r+b") as f:
            for _ in range(2):
                f.seek(0)
                f.write(os.urandom(n))
                f.flush()
                os.fsync(f.fileno())
    except OSError:
        pass
    os.unlink(VAULT)
    return True


def valid_left(v):
    """Seconds until the credential expires, or None if it does not say.

    valid_until is UTC ("...Z"). time.mktime() would read the struct as LOCAL
    time, so on any device not set to UTC this is wrong by the offset — and it
    fails closed, because cmd_fill refuses to type an expired card. Measured on
    the Pixel: a card minted two seconds earlier reported -2 seconds left and
    could not be filled at all. calendar.timegm() is the UTC-correct inverse.
    """
    vu = (v.get("card") or {}).get("valid_until")
    if not vu:
        return None
    try:
        t = calendar.timegm(time.strptime(vu, "%Y-%m-%dT%H:%M:%SZ"))
    except ValueError:
        return None
    return int(t - time.time())


def safe_summary(v):
    """Everything about the held card that is safe to say out loud."""
    c = v.get("card") or {}
    num = str(c.get("number") or "")
    left = valid_left(v)
    return {
        "spend_request_id": v.get("spend_request_id"),
        "merchant": v.get("merchant_name"),
        "amount": v.get("amount"),
        "brand": c.get("brand"),
        "last4": num[-4:] if len(num) >= 4 else None,
        "exp": "%02d/%s" % (int(c.get("exp_month") or 0),
                            str(c.get("exp_year") or "")[-2:]),
        "valid_for_seconds": left,
        "expired": (left is not None and left <= 0),
        "fields": sorted(FIELDS),
    }


# ------------------------------------------------------------------ the verbs
def cmd_mint(a):
    need_device()
    if os.path.exists(VAULT):
        old = vault_read()
        if not a.force:
            die("a card is already held (%s, %s). Use it, or `phone-pay done` "
                "first, or pass --force to replace it."
                % (safe_summary(old)["last4"], old.get("merchant_name")), 6)
        vault_shred()

    if len(a.context) < 100:
        die("--context must be at least 100 characters. This is the text the "
            "person reads when deciding whether to approve; it is the only "
            "thing standing between them and approving blind. Say what is "
            "being bought, from where, and why.", 2)

    argv = ["spend-request", "create",
            "--credentialType", "card",
            "--amount", str(a.amount),
            "--merchantName", a.merchant,
            "--context", a.context,
            "--requestApproval", "false"]
    if a.merchant_url:
        argv += ["--merchantUrl", a.merchant_url]
    if a.test:
        argv += ["--test"]

    d = link(*argv, timeout=90)
    sid, url = d.get("id"), d.get("approval_url")
    if not sid:
        die("no spend request id came back", 3)

    vault_write({"spend_request_id": sid, "status": d.get("status"),
                 "merchant_name": a.merchant, "amount": a.amount,
                 "test": bool(a.test), "created": time.time()})
    record("pay.mint", {"id": sid, "amount": a.amount,
                        "merchant": a.merchant, "test": bool(a.test)},
           d.get("status"))

    dollars = "$%.2f" % (a.amount / 100.0)
    notify("Approve %s?" % dollars, "%s — %s" % (a.merchant, url or ""))
    print(json.dumps({
        "spend_request_id": sid,
        "status": d.get("status"),
        "amount": a.amount,
        "merchant": a.merchant,
        "approval_url": url,
        "instruction": "Show the approval_url to the person and ask them to "
                       "approve it. Then run `phone-pay await`. No card exists "
                       "until they approve; nothing is charged by asking.",
        "_next": {"command": "phone-pay await"},
    }, indent=2))
    return 0


def cmd_await(a):
    need_device()
    v = vault_read()
    sid = v["spend_request_id"]
    out = os.path.join(VAULT_DIR, "cred.json")
    # link-cli writes the full credential to a file and keeps stdout redacted.
    # That file is the only place the number lands, and it lands here, 0600,
    # inside Termux private storage.
    if os.path.exists(out):
        os.unlink(out)
    attempts = max(1, int(a.timeout // 3))
    d = link("spend-request", "retrieve", sid,
             "--interval", "3", "--max-attempts", str(attempts),
             "--include", "card", "--outputFile", out, "--force",
             timeout=a.timeout + 30)
    status = d.get("status")

    if status != "approved":
        record("pay.await", {"id": sid}, status)
        vault_shred()
        if os.path.exists(out):
            os.unlink(out)
        print(json.dumps({"status": status, "spend_request_id": sid,
                          "card": None,
                          "note": "No credential was issued. Nothing was "
                                  "charged. The held request has been "
                                  "discarded."}, indent=2))
        return 1 if status in ("denied", "expired", "canceled") else 3

    if not os.path.exists(out):
        die("approved, but link-cli wrote no credential file", 3)
    with open(out, "r", encoding="utf-8") as f:
        cred = json.load(f)
    # Fold it into the vault and remove link-cli's copy: one file holds the
    # number, and `done` knows where it is.
    v.update(cred)
    v["status"] = "approved"
    vault_write(v)
    try:
        n = os.path.getsize(out)
        with open(out, "r+b") as f:
            f.write(os.urandom(n))
            f.flush()
            os.fsync(f.fileno())
    except OSError:
        pass
    os.unlink(out)

    s = safe_summary(v)
    record("pay.await", {"id": sid, "last4": s["last4"]}, "approved")
    print(json.dumps({"status": "approved", **s,
                      "instruction": "Focus a field on the checkout form, then "
                                     "`phone-pay fill <field>`. Run "
                                     "`phone-pay done` when the form is "
                                     "submitted or abandoned."}, indent=2))
    return 0


def cmd_fill(a):
    need_device()
    v = vault_read()
    if v.get("status") != "approved":
        die("no approved card held (status: %s). Run `phone-pay await`."
            % v.get("status"), 5)
    left = valid_left(v)
    if left is not None and left <= 0:
        die("the credential expired %ds ago. Run `phone-pay done` and mint a "
            "new one." % abs(left), 7)

    field = a.field
    if field not in FIELDS:
        die("unknown field %r. Known: %s" % (field, ", ".join(sorted(FIELDS))), 2)

    c = v.get("card") or {}
    if field == "exp":
        value = "%02d/%s" % (int(c.get("exp_month") or 0),
                             str(c.get("exp_year") or "")[-2:])
    else:
        node = v
        for k in FIELDS[field]:
            node = (node or {}).get(k) if isinstance(node, dict) else None
        value = node
    if value in (None, ""):
        die("the held card has no %s" % field, 5)
    value = str(value)
    if a.digits_only:
        value = re.sub(r"\D", "", value)

    if not re.fullmatch(r"[\x20-\x7e]+", value):
        die("refusing to type a value with control characters", 3)

    # `input text` at shell uid, reached through Shizuku from this Termux
    # process. The value is quoted, passed on ONE command line that we build
    # here and never log. It does not pass through `phone type`, whose ledger
    # stores the requested text verbatim.
    rish = os.path.join(os.path.expanduser("~"), "rish")
    if not os.path.exists(rish):
        die("rish is missing (~/rish) — no way to reach shell uid to type", 3)
    env = dict(os.environ, RISH_APPLICATION_ID="com.termux")
    inner = "input text %s" % shlex.quote(value)
    try:
        p = subprocess.run([rish, "-c", inner], capture_output=True, text=True,
                           timeout=45, env=env, cwd=os.path.expanduser("~"))
        rc, err = p.returncode, (p.stderr or "").strip()
    except subprocess.TimeoutExpired:
        rc, err = 124, "timed out"

    ok = (rc == 0)
    record("pay.fill", {"field": field, "chars": len(value),
                        "id": v.get("spend_request_id")},
           "dispatched" if ok else "failed")
    print(json.dumps({
        "field": field, "chars_typed": len(value) if ok else 0,
        "dispatched": ok,
        # `input text` exits 0 whether or not a field consumed it. Saying
        # "dispatched" rather than "filled" is the honest word — the caller
        # must read the screen back to know it landed.
        "note": "dispatched, not confirmed — read the field back with "
                "`phone look` before continuing" if ok else (err or "failed"),
    }, indent=2))
    return 0 if ok else 1


def cmd_status(a):
    if not os.path.exists(VAULT):
        print(json.dumps({"held": False}, indent=2))
        return 0
    v = vault_read()
    body = {"held": True, "status": v.get("status"), **safe_summary(v)}
    if v.get("status") != "approved":
        body["approval_pending"] = True
    print(json.dumps(body, indent=2))
    return 0


def cmd_done(a):
    v = None
    if os.path.exists(VAULT):
        try:
            v = vault_read()
        except SystemExit:
            v = None
    gone = vault_shred()
    stray = os.path.join(VAULT_DIR, "cred.json")
    if os.path.exists(stray):
        os.unlink(stray)
    if v:
        record("pay.done", {"id": v.get("spend_request_id")}, "shredded")
    print(json.dumps({"shredded": gone,
                      "note": "The credential is gone from this device. It was "
                              "single-use and time-boxed anyway; this just "
                              "stops it sitting around."}, indent=2))
    return 0


def main():
    ap = argparse.ArgumentParser(
        prog="phone-pay",
        description="mint a one-time card on this device and type it into the "
                    "screen, without the number reaching the agent")
    sub = ap.add_subparsers(dest="cmd", required=True)

    m = sub.add_parser("mint", help="ask for a card (needs human approval)")
    m.add_argument("--amount", type=int, required=True, help="cents")
    m.add_argument("--merchant", required=True)
    m.add_argument("--merchant-url", default="")
    m.add_argument("--context", required=True,
                   help="min 100 chars — what the person reads when approving")
    m.add_argument("--test", action="store_true", help="testmode, no real charge")
    m.add_argument("--force", action="store_true", help="replace a held card")
    m.set_defaults(fn=cmd_mint)

    w = sub.add_parser("await", help="block until the person decides")
    w.add_argument("--timeout", type=int, default=300)
    w.set_defaults(fn=cmd_await)

    f = sub.add_parser("fill", help="type one field into the focused input")
    f.add_argument("field", help=", ".join(sorted(FIELDS)))
    f.add_argument("--digits-only", action="store_true",
                   help="strip non-digits (some exp fields refuse the slash)")
    f.set_defaults(fn=cmd_fill)

    s = sub.add_parser("status", help="what is held, redacted")
    s.set_defaults(fn=cmd_status)

    d = sub.add_parser("done", help="shred the held credential")
    d.set_defaults(fn=cmd_done)

    a = ap.parse_args()
    raise SystemExit(a.fn(a))


if __name__ == "__main__":
    main()
